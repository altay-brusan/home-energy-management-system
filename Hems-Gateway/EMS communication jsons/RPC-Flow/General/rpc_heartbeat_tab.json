    {
        "id": "hb_manual_inject",
        "type": "inject",
        "z": "rpc_heartbeat_tab",
        "name": "Manual Test Heartbeat",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str",
                "v": "v1/devices/me/rpc/request/manual-test-123"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"method\":\"getHeartbeat\"}",
        "payloadType": "json",
        "x": 160,
        "y": 200,
        "wires": [
            [
                "hb_filter_method"
            ]
        ]
    },
    {
        "id": "hb_filter_method",
        "type": "function",
        "z": "rpc_heartbeat_tab",
        "name": "Filter: getHeartbeat only",
        "func": "const rpc = msg.payload || {};\n\n// Only handle getHeartbeat\nif (rpc.method !== 'getHeartbeat') {\n    return null;\n}\n\n// Extract request ID from topic\nconst parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 140,
        "wires": [
            [
                "hb_build_response"
            ]
        ]
    },
    {
        "id": "hb_build_response",
        "type": "function",
        "z": "rpc_heartbeat_tab",
        "name": "Build Heartbeat Response",
        "func": "const deviceId = global.get(\"DEVICE_ID\")\n    || env.get(\"DEVICE_ID\")\n    || \"EC100-DEV-001\";\n\nmsg.payload = {\n    kind: \"Heartbeat\",\n    timestampUtc: new Date().toISOString(),\n    DeviceId: deviceId,\n    status: \"ok\"\n};\n\nmsg.topic = msg.rpcResponseTopic;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"ok - \" + new Date().toLocaleTimeString() });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 140,
        "wires": [
            [
                "hb_debug",
                "hb_mqtt_response"
            ]
        ]
    },
    {
        "id": "hb_debug",
        "type": "debug",

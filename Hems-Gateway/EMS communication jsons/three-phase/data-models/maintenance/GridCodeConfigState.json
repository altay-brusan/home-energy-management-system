GridCodeConfigState {
  "timestampUtc": string,
  "gatewayId": string,
  "inverterSerialNumber": string,
  "version": string,

  // --- Basic grid profile (high-level) ---

  "gridModeRaw": number,              // 182 – country/grid code ID
  "gridFrequencyHz": number,          // 183 – 50 or 60
  "gridVoltageLevelCode": number,     // 138 – LN/LL voltage profile

  // --- Connection window (matches “Grid Setting / Connect”) ---

  "normalConnect": {
    "voltageLowV": number,            // 185 – Grid Vol Low
    "voltageHighV": number,           // 185/186 if you decide to split normal vs reconnect
    "frequencyLowHz": number,         // 188 – Grid Hz Low
    "frequencyHighHz": number         // 187 – Grid Hz High
    // You can later add ramp-rate and separate “reconnect window”
  },

  "reconnectionTimeSeconds": number,  // 180 – Restore connection time e.g. reg=60 → 60 s

  // --- Power factor / reactive power behaviour ---

  "powerFactorTarget": number,        // 193 – PF setting (% of nominal), e.g. 1000 = 1.00
  "activePowerRegulationPercentPerStep": number,   // 77 – Active-power regulation (0.1%) 
  "reactivePowerRegulationPercentPerStep": number  // 78 – Reactive-power regulation (0.1%)
  
  // Optionally: extra blocks later for:
  // - F(W) droop curves (FW screen → uses 75/76 plus a curve table)
  // - V(W)/V(Q) curves
  // - P(Q)/P(F) curves
  // - LVRT curve
}

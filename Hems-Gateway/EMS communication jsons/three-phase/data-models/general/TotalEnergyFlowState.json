TotalEnergyFlowState {
  "timestampUtc": string,
  "version": number,
  "deviceId": string,

  "grid": {
    // Lifetime energy bought from grid (import)
    "importTotalEnergyKWh": number,      // 522 (Low_Word), 523 (High_Word)

    // Lifetime energy sold to grid (export)
    "exportTotalEnergyKWh": number       // 524 (Low_Word), 525 (High_Word)
  },

  "pv": {
    // Lifetime PV generation – choose ONE of these depending on your firmware:
    // Option A: 528 = Total PV energy
    // Option B: 534–535 = Total production (as in that MQTT project)
    "totalEnergyKWh": number,            // 528 or [534, 535]

    "mppt": [
      {
        "id": 1,
        "totalEnergyKWh": number         // if available, or null if not mapped
      },
      {
        "id": 2,
        "totalEnergyKWh": number
      },
      {
        "id": 3,
        "totalEnergyKWh": number
      },
      {
        "id": 4,
        "totalEnergyKWh": number
      }
    ]
  },

  "load": {
    // Lifetime home/backup load consumption
    "totalEnergyKWh": number             // 527  Total_Load_Power
  },

  "battery": {
    // Lifetime energy moved through the battery bank in each direction
    "totalChargeEnergyKWh": number,      // 516 (Low_Word), 517 (High_Word)
    "totalDischargeEnergyKWh": number    // 518 (Low_Word), 519 (High_Word)
  },

  "generator": {
    // Lifetime generator production, if GEN is used
    "totalEnergyKWh": number             // 538  Total_Gen_Power
  }
}

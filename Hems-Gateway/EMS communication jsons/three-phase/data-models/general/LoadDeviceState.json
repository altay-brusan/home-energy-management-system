LoadDeviceState {
  "timestampUtc": string,
  "version": number,
  "DeviceId": string,

  // Which load this card represents
  "scope": string,                 // "backup_load" | "home_load" | "total_site"

  // --- Electrical ---
  "activePowerW": number,          // backup / UPS load total active power:
                                   // low word 653 + high word 659 (1 W)  // 653 + 659

  "apparentPowerVA": number | null,// UPS load total apparent power low word 637, high word nearby // 637 (+ high)

  "voltageV": number,              // load phase voltage A (single-phase) // 644
  "frequencyHz": number,           // inverter frequency (same seen by load) // 638

  // --- Energy (optional, for this specific load) ---
  "todayEnergyKWh": number | null, // Load today energy // 526
  "totalEnergyKWh": number | null  // Load total energy (lifetime) // 527
}

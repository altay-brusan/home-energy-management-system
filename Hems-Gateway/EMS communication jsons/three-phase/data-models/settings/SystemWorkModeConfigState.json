SystemWorkModeConfigState {
  "timestampUtc": string,
  "gatewayId": string,
  "inverterSerialNumber": string,
  "version": number,

  // 1) High-level *user* mode (what the app shows)
  "userModeProfile": "self_consumption"
                    | "backup"
                    | "time_of_use"
                    | "eco"
                    | "custom",

  // 2) Raw inverter work mode + export behavior
  "inverterMode": {
    // 141 – "System Work Mode"
    //   0 = Selling First
    //   1 = Zero Export to Load
    //   2 = Zero Export to CT
    "workModeCode": number,           // 141

    // Derived from workModeCode + exportLimitMode (142)
    "exportStrategy": "selling_first"
                    | "zero_export_to_load"
                    | "zero_export_to_ct",

    // 145 – "Solar sell"
    //   0x00 = PV does NOT sell
    //   0x01 = PV may sell to grid
    "solarSellEnabled": bool,         // 145

    // 143 – "Max. sell power"
    // Max allowed AC power exported to grid
    "maxSellPowerW": number | null,   // 143

    // Optional: some firmwares also expose a "default max sell power" (144)
    "defaultMaxSellPowerW": number | null,  // 144 (optional, can be same as 143)

    // For zero-export modes: allowed small bleed into grid (e.g. 20–100 W).
    // There is a "Zero export power" parameter, but its exact register is
    // not clearly documented in our excerpt, so we keep this as conceptual.
    // 144  Zero-export Power (W)
    "zeroExportLimitPowerW": number | null,  // HMI "Zero-export Power" // register TBD
    // 179: 0 = auto (connect to grid when ok)
    //      1 = force off-grid (stay islanded even if grid present)
    "forceOffGrid": bool              // 179
  },

  // 3) Energy source priority & grid peak shaving
  "energyPriority": {
    // 141 Bit0–1:
    //   10 = battery_first
    //   11 = load_first
    "pattern": "battery_first" | "load_first"
  },

  "gridPeakShaving": {
    // 178 Bit4–5:
    //   10 = grid peak-shaving disable
    //   11 = grid peak-shaving enable
    "enabled": bool,                   // 178 bits4–5

    // 191 – GRID peak shaving Power
    // Limit for how much power can be drawn from the grid
    "limitPowerW": number | null       // 191
  },

  // 4) Time-of-Use (ToU) schedule
  //
  // This directly matches the “System Work Mode → Time Of Use” pages.
  // We use SOC-based thresholds (lithium) and ignore the “voltage” option.

  "timeOfUse": {
    // 146 Bit0: 0 = disabled, 1 = enabled
    "enabled": bool,                   // 146.bit0

    // Which days the schedule is active (from the “Mon/Tue/…/Sun” page)
    // 146 Bits1–7: weekday flags
    "daysActive": {
      "monday":    bool,               // 146.bit1
      "tuesday":   bool,               // 146.bit2
      "wednesday": bool,               // 146.bit3
      "thursday":  bool,               // 146.bit4
      "friday":    bool,               // 146.bit5
      "saturday":  bool,               // 146.bit6
      "sunday":    bool                // 146.bit7
    }

    // NOTE: 146.bit8 = "Spain mode" – region-specific behaviour.
    // For your system you can keep this OFF and not expose it in the UI.

    ,

    // HMI shows up to 6 rows (01:00–05:00, …, 21:00–01:00)
    "slots": [
      {
        "slotIndex": number,           // 1..6 – TOU window index

        // Local wall-clock times, 24h HH:mm.
        //
        // Backed by 148–153: 6 "time points" stored as HHMM.
        // The gateway is responsible for mapping those points into
        // start/end per slot for the UI.
        "startTimeLocal": string,      // e.g. "01:00"  // from 148–153
        "endTimeLocal": string,        // e.g. "05:00"  // also from 148–153

        // Charge / sell flags for this slot
        // 172–177:
        //   Bit0 = grid charge enable
        //   Bit1 = generator charge enable
        //   Bit5 = sell mode enable for this slot
        "allowGridCharge": bool,       // 172–177.bit0
        "allowGeneratorCharge": bool,  // 172–177.bit1
        "sellEnabledInThisSlot": bool, // 172–177.bit5

        // Max allowed *discharge* power from battery in this slot
        // 154–159: TOU TimeX bat out power (per slot)
        "maxBatteryDischargePowerW": number,   // 154–159

        // Trigger threshold for this action.
        // In your lithium design you prefer SOC:
        // 166–171: Capacity1..6 (SOC thresholds, 1% step)
        // 160–165: target voltage (0.01 V) – used only in voltage mode
        "batteryThresholdSocPercent": number | null, // 166–171
        "batteryThresholdVoltageV": number | null    // 160–165 (usually null)
      }
      // up to 6 entries
    ]
  }
}
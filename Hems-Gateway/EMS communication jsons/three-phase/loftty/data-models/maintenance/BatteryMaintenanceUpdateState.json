BatteryMaintenanceConfigState {
  "timestampUtc": string,
  "gatewayId": string,
  "inverterSerialNumber": string,
  "version": string,

  // We usually keep this fixed to "capacity" in your design,
  // but if admins *really* want to switch modes, they can:
  "batteryControlMode": "capacity" | "voltage" | null,  // 111

  "wakeUp": {
    "channel1Enabled": bool | null,    // 112 Bit0 (0=enabled,1=disable)
    "channel2Enabled": bool | null     // 112 Bit8 (0=enabled,1=disable)
  },

  "batteryResistanceMilliOhm": number | null,    // 113
  "chargeEfficiencyPercent": number | null       // 114 (0.1% step)
}

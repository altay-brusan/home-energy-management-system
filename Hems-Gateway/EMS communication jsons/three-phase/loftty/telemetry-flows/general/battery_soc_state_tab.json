    {
        "id": "bss_prepare_bat1",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Prepare read Bat1 (214)",
        "func": "// Battery 1 SOC\n// 214: Battery 1 capacity %\n\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 214,\n    quantity: 1\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,

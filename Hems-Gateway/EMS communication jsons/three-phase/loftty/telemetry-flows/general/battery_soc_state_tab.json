    {
        "id": "bss_store_bat1",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Store Bat1 partial",
        "func": "// Store Battery 1 SOC partial\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nconst bat1Soc = data[0] || 0;\nflow.set(\"bss_part_bat1\", bat1Soc);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,
        "y": 100,
        "wires": [
            [
                "bss_build_json"
            ]
        ]
    },
    {
        "id": "bss_store_bat2",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Store Bat2 partial",
        "func": "// Store Battery 2 SOC partial\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nconst bat2Soc = data[0] || 0;\nflow.set(\"bss_part_bat2\", bat2Soc);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,
        "y": 200,
        "wires": [
            [
                "bss_build_json"
            ]
        ]
    },
    {
        "id": "bss_build_json",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Build BatterySocState JSON",
        "func": "// Wait for both partials\nconst bat1Soc = flow.get(\"bss_part_bat1\");\nconst bat2Soc = flow.get(\"bss_part_bat2\");\n\nif (bat1Soc === undefined || bat2Soc === undefined) {\n    return null;  // Wait for both\n}\n\n// Clear partials\nflow.set(\"bss_part_bat1\", undefined);\nflow.set(\"bss_part_bat2\", undefined);\n\nconst deviceId = msg.deviceId\n    || global.get(\"DEVICE_ID\")\n    || env.get(\"DEVICE_ID\")\n    || \"EC100-DEV-001\";\n\nconst state = {\n    kind: \"BatterySocState\",\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    DeviceId: deviceId,\n    \n    inverterBatChannelSoc: [\n        {\n            channelId: 1,\n            socPercent: bat1Soc  // Register 214\n        },\n        {\n            channelId: 2,\n            socPercent: bat2Soc  // Register 245\n        }\n    ],\n    \n    bmsSocDetails: [\n        {\n            channelId: 1,\n            deviceId: \"CH1-BMS1\",\n            socPercent: bat1Soc  // Same as inverter reading for now\n        },\n        {\n            channelId: 2,\n            deviceId: \"CH2-BMS1\",\n            socPercent: bat2Soc  // Same as inverter reading for now\n        }\n    ]\n};\n\nflow.set(\"batterySocStateSnapshot\", state);\n\nmsg.payload = state;\nmsg.state = state;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1420,
        "y": 150,
        "wires": [
            [
                "bss_check_rpc",
                "bss_debug_json"
            ]
        ]
    },
    {
        "id": "bss_check_rpc",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Check if RPC",
        "func": "if (msg.isRpcRequest && msg.rpcResponseTopic) {\n    msg.topic = msg.rpcResponseTopic;\n    return [msg, null];  // RPC response\n} else {\n    return [null, msg];  // MQTT telemetry\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1680,
        "y": 150,
        "wires": [
            [
                "bss_rpc_response"
            ],
            [
                "bss_mqtt_telemetry"
            ]
        ]
    },

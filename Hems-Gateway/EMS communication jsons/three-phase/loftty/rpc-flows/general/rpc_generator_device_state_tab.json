    },
    {
        "id": "rpc_gds_mqtt_in",
        "type": "mqtt in",
        "z": "rpc_generator_device_state_tab",
        "name": "RPC Request",
        "topic": "v1/devices/me/rpc/request/+",
        "qos": "2",
        "datatype": "json",
        "broker": "tb-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,

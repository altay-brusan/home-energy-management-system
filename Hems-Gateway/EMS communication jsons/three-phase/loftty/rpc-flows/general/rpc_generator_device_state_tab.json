                "rpc_gds_handle"
            ]
        ]
    },
    {
        "id": "rpc_gds_handle",
        "type": "function",
        "z": "rpc_generator_device_state_tab",
        "name": "Handle RPC",
        "func": "const parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\n\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\n\nconst rpc = msg.payload || {};\n\nmsg.rpcMethod = rpc.method;\nmsg.rpcParams = rpc.params || {};\n\n// Only handle getGeneratorDeviceState\nif (msg.rpcMethod !== 'getGeneratorDeviceState') {\n    return null;\n}\n\n// Mark as RPC request - always send response\nmsg.isRpcRequest = true;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 120,
        "wires": [
            [
                "rpc_gds_link_out"
            ]
        ]
    },
    {
        "id": "rpc_gds_link_out",
        "type": "link out",
        "z": "rpc_generator_device_state_tab",
        "name": "To GeneratorDeviceState",
        "mode": "link",
        "links": [

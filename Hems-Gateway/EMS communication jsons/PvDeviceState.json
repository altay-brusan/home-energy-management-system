PvDeviceState {
   "timestampUtc": string,
   "version": number,
   "DeviceId": string,

  // Total site PV
  "totalPvPowerW": number,         // PV total input power (sum of 672–675) // 672–675
  "todayPvEnergyKWh": number,      // PV today energy // 529
  "totalPvEnergyKWh": number | null,// PV lifetime energy // 528 (if enabled)

  // Per-tracker live data
  "mppt": [
    {
      "pvChannelId": number,       // 1
      "isActive": bool,            // derived: dcVoltageV > threshold

      "dcVoltageV": number,        // PV1 input voltage // 676
      "dcCurrentA": number,        // PV1 input current // 677
      "inputPowerW": number,       // PV1 input power // 672

      "todayEnergyKWh": number,    // PV1 today energy // 530
      "totalEnergyKWh": number | null // PV1 lifetime energy // 522/524 depending on FW
    },
    {
      "pvChannelId": number,       // 2
      "isActive": bool,

      "dcVoltageV": number,        // 678
      "dcCurrentA": number,        // 679
      "inputPowerW": number,       // 673

      "todayEnergyKWh": number,    // 531
      "totalEnergyKWh": number | null
    },
    {
      "pvChannelId": number,       // 3
      "isActive": bool,

      "dcVoltageV": number,        // 680
      "dcCurrentA": number,        // 681
      "inputPowerW": number,       // 674

      "todayEnergyKWh": number,    // 532
      "totalEnergyKWh": number | null
    },
    {
      "pvChannelId": number,       // 4
      "isActive": bool,

      "dcVoltageV": number,        // 682
      "dcCurrentA": number,        // 683
      "inputPowerW": number,       // 675

      "todayEnergyKWh": number,    // 533
      "totalEnergyKWh": number | null
    }
  ]
}

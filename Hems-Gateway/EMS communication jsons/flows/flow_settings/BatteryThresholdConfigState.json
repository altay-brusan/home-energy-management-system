    {
        "id": "bthr_prepare_read",
        "type": "function",
        "z": "bat_threshold_config_tab",
        "name": "Prepare read (Thresholds 217-219)",
        "func": "// Battery threshold settings\n// 217: battery capacity ShutDown (1%)\n// 218: battery capacity Restart (1%)\n// 219: battery capacity LowBatt (1%)\n\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 217,\n    quantity: 3\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 120,
        "wires": [
            [
                "bthr_read"
            ]
        ]
    },
    {
        "id": "bthr_read",
        "type": "modbus-flex-getter",
        "z": "bat_threshold_config_tab",
        "name": "Read Thresholds (217-219)",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "logIOActivities": false,
        "server": "e4e4f3e2a4f4e004",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": true,
        "keepMsgProperties": true,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 750,
        "y": 120,
        "wires": [
            [
                "bthr_build_json"
            ],
            [
                "bthr_error_debug"
            ]
        ]
    },
    {
        "id": "bthr_build_json",
        "type": "function",
        "z": "bat_threshold_config_tab",
        "name": "Build BatteryThresholdConfigState JSON",
        "func": "// Build BatteryThresholdConfigState from Modbus read.\n//\n// Registers:\n// 217: battery capacity ShutDown (1%)\n// 218: battery capacity Restart (1%)\n// 219: battery capacity LowBatt (1%)\n\nlet raw = msg.payload;\n\n// node-red-contrib-modbus often sends { data: [...], buffer: ... }\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\n// Skip string errors\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nconst shutdownCapacity = data[0] || 0;   // 217\nconst restartCapacity = data[1] || 0;    // 218\nconst lowBattCapacity = data[2] || 0;    // 219\n\n// Resolve identifiers\nconst gatewayId = msg.gatewayId\n    || global.get(\"GATEWAY_ID\")\n    || env.get(\"GATEWAY_ID\")\n    || \"EC100-GW-001\";\n\nconst inverterSN = msg.inverterSerialNumber\n    || global.get(\"INVERTER_SN\")\n    || env.get(\"INVERTER_SN\")\n    || \"Unknown\";\n\nconst state = {\n    kind: \"BatteryThresholdConfigState\",\n    timestampUtc: new Date().toISOString(),\n    gatewayId: gatewayId,\n    inverterSerialNumber: inverterSN,\n    \n    shutdownCapacityPercent: shutdownCapacity,\n    restartCapacityPercent: restartCapacity,\n    lowBatteryCapacityPercent: lowBattCapacity\n};\n\n// Keep snapshot in flow\nflow.set(\"batteryThresholdConfigSnapshot\", state);\n\n// Put result on msg\nmsg.payload = state;\nmsg.state = state;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 120,
        "wires": [
            [
                "bthr_debug_json",
                "bthr_mqtt_telemetry"
            ]
        ]
    },
    {
        "id": "bthr_debug_json",
        "type": "debug",
        "z": "bat_threshold_config_tab",
        "name": "BatteryThresholdConfigState JSON",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",

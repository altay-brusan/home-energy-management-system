    {
        "id": "gensmartload_route",
        "type": "function",
        "z": "gen_smartload_tab",
        "name": "Route: Read or Write?",
        "func": "flow.set(\"gensmartload_rpc_response_topic\", msg.rpcResponseTopic);\n\nlet operation = msg.operation || 'read';\nconst params = msg.rpcParams || {};\n\nif (params.forceSmartLoadOn !== undefined) {\n    operation = 'write';\n}\n\nmsg.operation = operation;\n\nif (operation === 'write') {\n    return [null, msg];\n} else {\n    return [msg, null];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 200,
        "wires": [
            [
                "gensmartload_start_read"
            ],
            [
                "gensmartload_prepare_write"
            ]
        ]
    },

    {
        "id": "gensmartload_collect",
        "type": "function",
        "z": "gen_smartload_tab",
        "name": "Collect Parts",
        "func": "let data = msg.payload;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (!Array.isArray(data)) {\n    node.error(\"Invalid response for \" + msg.readGroup);\n    return null;\n}\n\nconst group = msg.readGroup;\n\nif (group === \"sn\") {\n    flow.set(\"gensmartload_part_sn\", data);\n} else if (group === \"regs\") {\n    flow.set(\"gensmartload_part_234\", data[0]);\n    flow.set(\"gensmartload_part_235\", data[1]);\n}\n\nconst partSn = flow.get(\"gensmartload_part_sn\");\nconst part234 = flow.get(\"gensmartload_part_234\");\nconst part235 = flow.get(\"gensmartload_part_235\");\n\nif (!partSn || part234 === null || part234 === undefined ||\n    part235 === null || part235 === undefined) {\n    return null;\n}\n\nmsg.snData = partSn;\nmsg.reg234 = part234;\nmsg.reg235 = part235;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1230,
        "y": 140,
        "wires": [
            [
                "gensmartload_build_json"
            ]
        ]
    },
    {
        "id": "gensmartload_build_json",
        "type": "function",
        "z": "gen_smartload_tab",
        "name": "Build JSON State",
        "func": "const snData = msg.snData;\nconst reg234 = msg.reg234;\nconst reg235 = msg.reg235;\n\nflow.set(\"gensmartload_part_sn\", null);\nflow.set(\"gensmartload_part_234\", null);\nflow.set(\"gensmartload_part_235\", null);\n\nfunction parseAsciiChar(val, high) {\n    const byte = high ? ((val >> 8) & 0xFF) : (val & 0xFF);\n    if (byte >= 0x20 && byte <= 0x7E) {\n        return String.fromCharCode(byte);\n    }\n    return '';\n}\n\nfunction parseSerialNumber(regs) {\n    let sn = '';\n    for (let i = 0; i < 5; i++) {\n        sn += parseAsciiChar(regs[i], true);\n        sn += parseAsciiChar(regs[i], false);\n    }\n    return sn.trim();\n}\n\nconst serialNumber = parseSerialNumber(snData);\nconst forceSmartLoadOn = reg234 === 1;\nconst generatorAsLoadEnabled = reg235 === 1;\n\nconst gatewayId = global.get(\"GATEWAY_ID\") || env.get(\"GATEWAY_ID\") || \"EC100-GW-001\";\n\nconst state = {\n    kind: \"GeneratorSmartLoadOverride\",\n    timestampUtc: new Date().toISOString(),\n    gatewayId: gatewayId,\n    inverterSerialNumber: serialNumber,\n    version: \"1.0\",\n    \n    forceSmartLoadOn: forceSmartLoadOn,\n    generatorAsLoadEnabled: generatorAsLoadEnabled,\n    canForce: generatorAsLoadEnabled\n};\n\nconst writeResult = flow.get(\"gensmartload_write_result\");\nflow.set(\"gensmartload_write_result\", null);\n\nconst rpcResponseTopic = flow.get(\"gensmartload_rpc_response_topic\");\nflow.set(\"gensmartload_rpc_response_topic\", null);\n\nif (writeResult) {\n    msg.payload = {\n        success: true,\n        message: writeResult.message,\n        state: state\n    };\n} else {\n    msg.payload = state;\n}\n\nmsg.rpcResponseTopic = rpcResponseTopic;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1430,
        "y": 140,
        "wires": [
            [
                "gensmartload_debug",
                "gensmartload_rpc_response"
            ]
        ]
    },

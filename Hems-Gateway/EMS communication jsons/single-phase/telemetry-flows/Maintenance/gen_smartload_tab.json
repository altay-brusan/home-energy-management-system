    {
        "id": "gensmartload_prepare_write",
        "type": "function",
        "z": "gen_smartload_tab",
        "name": "Prepare Write",
        "func": "const params = msg.rpcParams || {};\n\nif (params.forceSmartLoadOn === undefined) {\n    node.warn(\"No forceSmartLoadOn parameter\");\n    return null;\n}\n\nconst val = params.forceSmartLoadOn ? 1 : 0;\n\nmsg.payload = {\n    fc: 16,\n    unitid: 1,\n    address: 234,\n    quantity: 1,\n    value: [val]\n};\nmsg.writeValue = val;\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"Writing reg234=\" + val });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 340,

        "func": "const val = msg.writeValue;\n\nflow.set(\"gensmartload_write_result\", {\n    message: `Successfully wrote register 234 = ${val} (forceSmartLoadOn = ${val === 1})`\n});\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"Write OK\" });\n\nreturn msg;",

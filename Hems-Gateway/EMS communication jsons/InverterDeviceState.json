InverterDeviceState {
   "timestampUtc": string,
   "version": number,
   "DeviceId": string,

  "runState": string,              // "standby" | "selfcheck" | "normal" | "alarm" | "fault" | "activating" // 500

  // --- Output to AC bus ---
  "outputActivePowerW": number,    // inverter output total active power, low word 636 + high word nearby // 636 (+ high)
  "outputApparentPowerVA": number, // inverter output total apparent power, low word 637 + high // 637 (+ high)

  "outputVoltageV": number,        // phase A voltage (single phase) // 627
  "outputCurrentA": number,        // phase A current // 630
  "outputFrequencyHz": number,     // inverter frequency // 638

  // --- Grid-side view (import/export) ---
  "gridSideActivePowerW": number,  // grid side total power, low word 625 + high word // 625 (+ high)
  "gridSidePhaseAPowerW": number,  // grid side A-phase power, low word 622 + high // 622 (+ high)
  "gridSidePhaseBPowerW": number | null, // 623 (+ high) on 3-phase models // 623
  "gridSidePhaseCPowerW": number | null, // 624 (+ high) on 3-phase models // 624

  // --- Temperatures (if you want to show health) ---
  "inverterHeatsinkTempC": number | null, // inverter temperature register (around 540s in protocol)
  "internalAmbientTempC": number | null   // internal temp if provided (see temperature block)

    "acInputStatus": {
    "genGridSignalRaw": number,    // 140

    "gridSignalPresent": bool,     // 140 bit0 == 1  → grid OK
    "generatorSignalPresent": bool // 140 bit1 == 1  → generator OK
  }
}

    {
        "id": "ts_write_ec100",
        "type": "function",
        "z": "time_sync_test_tab",
        "name": "Build EC100 Command",
        "func": "const t = msg.payload;\n\n// Format: YYYY-MM-DD HH:MM:SS\nconst dateStr = `${t.year}-${String(t.month).padStart(2,'0')}-${String(t.day).padStart(2,'0')} ` +\n                `${String(t.hour).padStart(2,'0')}:${String(t.minute).padStart(2,'0')}:${String(t.second).padStart(2,'0')}`;\n\nmsg.payload = dateStr;\nnode.status({ fill: \"yellow\", shape: \"dot\", text: \"Setting: \" + dateStr });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

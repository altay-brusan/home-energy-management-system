    {
        "id": "ts_build_inv_regs",
        "type": "function",
        "z": "time_sync_test_tab",
        "name": "Build Inverter Registers",
        "func": "const t = msg.payload;\n\n// Register 022: Year (2000-based) << 8 | Month\n// Register 023: Day << 8 | Hour\n// Register 024: Minute << 8 | Second\n\nconst yearByte = t.year - 2000;  // 2025 -> 25\nconst reg022 = (yearByte << 8) | t.month;\nconst reg023 = (t.day << 8) | t.hour;\nconst reg024 = (t.minute << 8) | t.second;\n\nconst formatted = `${t.year}-${String(t.month).padStart(2,'0')}-${String(t.day).padStart(2,'0')} ` +\n                  `${String(t.hour).padStart(2,'0')}:${String(t.minute).padStart(2,'0')}:${String(t.second).padStart(2,'0')}`;\n\nmsg.payload = {\n    fc: 16,\n    unitid: 1,\n    address: 22,\n    quantity: 3,\n    value: [reg022, reg023, reg024]\n};\n\nmsg.timeData = {\n    formatted: formatted,\n    reg022: reg022,\n    reg023: reg023,\n    reg024: reg024,\n    reg022_hex: '0x' + reg022.toString(16).padStart(4, '0'),\n    reg023_hex: '0x' + reg023.toString(16).padStart(4, '0'),\n    reg024_hex: '0x' + reg024.toString(16).padStart(4, '0')\n};\n\nnode.status({ fill: \"yellow\", shape: \"dot\", text: \"Setting: \" + formatted });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 360,
        "wires": [
            [
                "ts_debug_inv_regs",
                "ts_modbus_write"
            ]
        ]
    },

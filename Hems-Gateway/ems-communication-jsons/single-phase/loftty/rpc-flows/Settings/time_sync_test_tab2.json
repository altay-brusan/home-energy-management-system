    {
        "id": "ts_parse_ec100_time",
        "type": "function",
        "z": "time_sync_test_tab",
        "name": "Parse EC100",
        "func": "const output = msg.payload.toString().trim();\nconst parts = output.replace(' UTC', '').split(/[\\s:-]/);\n\nconst ec100Time = {\n    source: 'EC100 Gateway',\n    raw: output,\n    year: parseInt(parts[0]),\n    month: parseInt(parts[1]),\n    day: parseInt(parts[2]),\n    hour: parseInt(parts[3]),\n    minute: parseInt(parts[4]),\n    second: parseInt(parts[5])\n};\n\nmsg.payload = ec100Time;\nnode.status({ fill: \"green\", shape: \"dot\", text: output });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 60,

    {
        "id": "ts_inject_inv_write",
        "type": "inject",
        "z": "time_sync_test_tab",
        "name": "Test: Set Inverter to 10:00:00",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"year\":2025,\"month\":12,\"day\":5,\"hour\":10,\"minute\":0,\"second\":0}",
        "payloadType": "json",

    {
        "id": "ts_parse_inverter_time",
        "type": "function",
        "z": "time_sync_test_tab",
        "name": "Parse Inverter",
        "func": "let data = msg.payload;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (!Array.isArray(data) || data.length < 3) {\n    node.error(\"Invalid inverter time data\");\n    return null;\n}\n\nconst reg022 = data[0];\nconst reg023 = data[1];\nconst reg024 = data[2];\n\nconst year = ((reg022 >> 8) & 0xFF) + 2000;\nconst month = reg022 & 0xFF;\nconst day = (reg023 >> 8) & 0xFF;\nconst hour = reg023 & 0xFF;\nconst minute = (reg024 >> 8) & 0xFF;\nconst second = reg024 & 0xFF;\n\nconst formatted = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')} ` +\n                  `${String(hour).padStart(2,'0')}:${String(minute).padStart(2,'0')}:${String(second).padStart(2,'0')}`;\n\nmsg.payload = {\n    source: 'Inverter',\n    year: year,\n    month: month,\n    day: day,\n    hour: hour,\n    minute: minute,\n    second: second,\n    formatted: formatted\n};\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: formatted });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 100,
        "wires": [
            [
                "ts_debug_inverter"
            ]
        ]
    },

[
    {
        "id": "rpc_batt_maint_tab",
        "type": "tab",
        "label": "RPC_BatteryMaintenance",
        "disabled": false,
        "info": "RPC Handler for BatteryMaintenanceConfigState\nMethods:\n- getBatteryMaintenanceConfig (read)\n- setBatteryMaintenanceConfig (write + read)"
    },
    {
        "id": "rpc_battmaint_mqtt_in",
        "type": "mqtt in",
        "z": "rpc_batt_maint_tab",
        "name": "RPC Request",
        "topic": "v1/devices/me/rpc/request/+",
        "qos": "2",
        "datatype": "json",
        "broker": "tb-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 160,
        "wires": [
            [
                "rpc_battmaint_handle"
            ]
        ]
    },
    {
        "id": "rpc_battmaint_handle",
        "type": "function",
        "z": "rpc_batt_maint_tab",
        "name": "Handle RPC",
        "func": "const parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\n\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\n\nconst rpc = msg.payload || {};\n\nmsg.rpcMethod = rpc.method;\nmsg.rpcParams = rpc.params || {};\n\nif (msg.rpcMethod === 'getBatteryMaintenanceConfig') {\n    msg.operation = 'read';\n    return msg;\n}\nelse if (msg.rpcMethod === 'setBatteryMaintenanceConfig') {\n    msg.operation = 'write';\n    return msg;\n}\nelse {\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 160,
        "wires": [
            [
                "rpc_battmaint_link_out"
            ]
        ]
    },
    {
        "id": "rpc_battmaint_link_out",
        "type": "link out",
        "z": "rpc_batt_maint_tab",
        "name": "To Main Flow",
        "mode": "link",
        "links": [
            "battmaint_link_in_rpc"
        ],
        "x": 495,
        "y": 160,
        "wires": []
    },
    {
        "id": "rpc_battmaint_comment",
        "type": "comment",
        "z": "rpc_batt_maint_tab",
        "name": "getBatteryMaintenanceConfig / setBatteryMaintenanceConfig",
        "info": "Read/Write battery maintenance config:\n- batteryControlMode: voltage | capacity | null\n- wakeUp.channel1Enabled: bool\n- batteryResistanceMilliOhm: number\n- chargeEfficiencyPercent: number (0-100)",
        "x": 290,
        "y": 100,
        "wires": []
    },

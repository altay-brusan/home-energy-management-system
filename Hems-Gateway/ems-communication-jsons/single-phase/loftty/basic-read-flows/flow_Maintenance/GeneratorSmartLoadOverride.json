    {
        "id": "gslo_prepare_read",
        "type": "function",
        "z": "gen_sl_override_tab",
        "name": "Prepare read (ForceSmartLoad 234)",
        "func": "// Force on generator as load function\n// 234: 强制开启发电机作为负载功能\n// prerequisite: reg 235 = 1\n// 0 = do not force, 1 = force\n\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 234,\n    quantity: 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 120,
        "wires": [
            [
                "gslo_read"
            ]
        ]
    },
    {
        "id": "gslo_read",
        "type": "modbus-flex-getter",
        "z": "gen_sl_override_tab",
        "name": "Read ForceSmartLoad (234)",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "logIOActivities": false,
        "server": "e4e4f3e2a4f4e004",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": true,
        "keepMsgProperties": true,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 760,
        "y": 120,
        "wires": [
            [
                "gslo_build_json"
            ],
            [
                "gslo_error_debug"
            ]
        ]
    },
    {
        "id": "gslo_build_json",
        "type": "function",
        "z": "gen_sl_override_tab",
        "name": "Build GeneratorSmartLoadOverride JSON",
        "func": "// Build GeneratorSmartLoadOverride from Modbus read.\n//\n// Register:\n// 234: Force on generator as load function\n//      0 = do not force, 1 = force\n\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nconst forceSmartLoadOn = (data[0] || 0) === 1;\n\nconst state = {\n    kind: \"GeneratorSmartLoadOverride\",\n    timestampUtc: new Date().toISOString(),\n    forceSmartLoadOn: forceSmartLoadOn\n};\n\nflow.set(\"generatorSmartLoadOverrideSnapshot\", state);\n\nmsg.payload = state;\nmsg.state = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 120,
        "wires": [
            [
                "gslo_debug_json",
                "gslo_mqtt_telemetry"
            ]
        ]
    },

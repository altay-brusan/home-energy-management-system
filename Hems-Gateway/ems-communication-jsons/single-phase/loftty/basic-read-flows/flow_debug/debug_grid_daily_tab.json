    {
        "id": "dgd_parse_response",
        "type": "function",
        "z": "debug_grid_daily_tab",
        "name": "Parse & Format",
        "func": "// Parse Grid Daily Energy registers\n\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (!Array.isArray(data) || data.length < 2) {\n    node.warn(\"Invalid data received\");\n    return null;\n}\n\nconst reg76_raw = data[0] || 0;  // Day Grid Buy\nconst reg77_raw = data[1] || 0;  // Day Grid Sell\n\nconst result = {\n    timestampUtc: new Date().toISOString(),\n    \n    // Raw values\n    raw: {\n        reg76: reg76_raw,\n        reg77: reg77_raw,\n        reg76_hex: \"0x\" + reg76_raw.toString(16).padStart(4, '0'),\n        reg77_hex: \"0x\" + reg77_raw.toString(16).padStart(4, '0')\n    },\n    \n    // Converted values (0.1 kWh scale)\n    converted: {\n        dayGridBuyKWh: Math.round(reg76_raw * 0.1 * 10) / 10,\n        dayGridSellKWh: Math.round(reg77_raw * 0.1 * 10) / 10\n    },\n    \n    // Alternative interpretations\n    alternativeInterpretations: {\n        // Maybe Wh instead of 0.1 kWh?\n        asWh: {\n            dayGridBuyWh: reg76_raw,\n            dayGridSellWh: reg77_raw\n        },\n        // Maybe 1 kWh scale?\n        as1kWh: {\n            dayGridBuyKWh: reg76_raw,\n            dayGridSellKWh: reg77_raw\n        },\n        // Maybe 0.01 kWh scale?\n        as001kWh: {\n            dayGridBuyKWh: Math.round(reg76_raw * 0.01 * 100) / 100,\n            dayGridSellKWh: Math.round(reg77_raw * 0.01 * 100) / 100\n        }\n    }\n};\n\nmsg.payload = result;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 100,
        "wires": [
            [
                "dgd_parsed_debug"
            ]
        ]
    },

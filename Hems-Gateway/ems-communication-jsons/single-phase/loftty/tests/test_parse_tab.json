    {
        "id": "test_parse_analyze",
        "type": "function",
        "z": "test_parse_tab",
        "name": "Analyze Value",
        "func": "let data = msg.payload;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nconst val = data[0];\nconst group = msg.readGroup;\n\nlet result = {\n    register: group,\n    rawValue: val,\n    hex: '0x' + val.toString(16).toUpperCase().padStart(4, '0'),\n    binary: val.toString(2).padStart(16, '0')\n};\n\nif (group === 'reg0') {\n    // Device Type analysis\n    result.analysis = {\n        'if_0x0003': 'Unknown',\n        'if_0x0200': 'String Inverter',\n        'if_0x0300': 'Single-phase Storage Inverter',\n        'if_0x0400': 'Microinverter',\n        'if_0x0500': 'Three-phase Storage Inverter',\n        'detected': val === 3 ? 'Value is 3 (0x0003) - maybe same as 0x0300?' : 'Check mapping'\n    };\n} else if (group === 'reg18') {\n    // MPPT & Phase analysis\n    // Method 1: Nibble (4-bit) parsing\n    const mppt_nibble = (val >> 4) & 0x0F;\n    const phase_nibble = val & 0x0F;\n    \n    // Method 2: Byte (8-bit) parsing  \n    const mppt_byte = (val >> 8) & 0xFF;\n    const phase_byte = val & 0xFF;\n    \n    result.analysis = {\n        'method1_nibble': {\n            mpptCount: mppt_nibble,\n            phaseCount: phase_nibble,\n            note: '(val >> 4) & 0x0F / val & 0x0F'\n        },\n        'method2_byte': {\n            mpptCount: mppt_byte,\n            phaseCount: phase_byte,\n            note: '(val >> 8) & 0xFF / val & 0xFF'\n        },\n        'doc_example': '0x0503 = 5 MPPT, 3 phase (byte method)'\n    };\n}\n\nmsg.payload = result;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 100,
        "wires": [
            [
                "test_parse_debug"
            ]
        ]
    },

[
    {
        "id": "rpc_set_datetime_tab",
        "type": "tab",
        "label": "RPC_SetDateTime",
        "disabled": false,
        "info": "RPC Handler for SetDateTime\nMethods:\n- setDateTime (set both gateway and inverter time)\n- getDateTime (read inverter time)"
    },
    {
        "id": "rpc_sdt_mqtt_in",
        "type": "mqtt in",
        "z": "rpc_set_datetime_tab",
        "name": "RPC Request",
        "topic": "v1/devices/me/rpc/request/+",
        "qos": "2",
        "datatype": "json",
        "broker": "tb-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 160,
        "wires": [
            [
                "rpc_sdt_handle"
            ]
        ]
    },
    {
        "id": "rpc_sdt_handle",
        "type": "function",
        "z": "rpc_set_datetime_tab",
        "name": "Handle RPC",
        "func": "const parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\n\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\n\nconst rpc = msg.payload || {};\n\nmsg.rpcMethod = rpc.method;\nmsg.rpcParams = rpc.params || {};\n\nif (msg.rpcMethod === 'setDateTime') {\n    msg.isRpcRequest = true;\n    return msg;\n}\nelse if (msg.rpcMethod === 'getDateTime') {\n    msg.isRpcRequest = true;\n    msg.operationType = 'read';\n    return msg;\n}\nelse {\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 160,
        "wires": [
            [
                "rpc_sdt_link_out"
            ]
        ]
    },
    {
        "id": "rpc_sdt_link_out",
        "type": "link out",
        "z": "rpc_set_datetime_tab",
        "name": "To Main Flow",
        "mode": "link",
        "links": [
            "sdt_link_in_rpc"
        ],
        "x": 495,
        "y": 160,
        "wires": []
    },
    {
        "id": "rpc_sdt_comment",
        "type": "comment",
        "z": "rpc_set_datetime_tab",
        "name": "setDateTime / getDateTime",
        "info": "setDateTime params:\n- dateTimeUtc: ISO string (optional, defaults to now)\n- timezone: string (default: Europe/Istanbul)\n- syncGateway: bool (default: true)\n- syncInverter: bool (default: true)\n\ngetDateTime: reads inverter time registers",
        "x": 210,
        "y": 100,
        "wires": []
    },

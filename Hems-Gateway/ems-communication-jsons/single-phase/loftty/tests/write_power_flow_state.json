    {
        "id": "235c027edffcac91",
        "type": "function",
        "z": "08ea7342fb7b2ed2",
        "name": "Build PowerFlowState JSON",
        "func": "// Build PowerFlowState from multiple small Modbus reads.\n//\n// Blocks (single-phase):\n// 166 : generator power (W, signed)\n// 169 : grid total power (W, signed; +import, -export)\n// 178 : load total power (W, signed)\n// 186-189 : PV1..PV4 input power (W)\n// 190 : battery output power (W, signed; +discharge, -charge)\n\nlet raw = msg.payload;\n\n// node-red-contrib-modbus often sends { data: [...], buffer: ... }\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n  data = data.data;\n}\n\n// Skip string errors like \"Error: CRC error\"\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n  return null;\n}\n\n// Determine which block we just read\nlet baseAddr = (msg.modbusRequest && msg.modbusRequest.address);\nif (typeof baseAddr !== \"number\") {\n  baseAddr = msg.baseAddr;\n}\nif (typeof baseAddr !== \"number\") {\n  node.warn(\"PowerFlowState: missing base address on msg\");\n  return null;\n}\n\n// helper: signed 16-bit\nfunction s16(v) {\n  if (!Number.isFinite(v)) return null;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\n// ---- Store partials in flow context ----\n\n// PV block 186–189\nif (baseAddr === 186) {\n  const pv1W = s16(data[0]) || 0;\n  const pv2W = s16(data[1]) || 0;\n  const pv3W = s16(data[2]) || 0;\n  const pv4W = s16(data[3]) || 0;\n\n  const part = {\n    pv: {\n      mppt: [\n        { id: 1, powerW: pv1W },\n        { id: 2, powerW: pv2W },\n        { id: 3, powerW: pv3W },\n        { id: 4, powerW: pv4W }\n      ],\n      totalPowerW: pv1W + pv2W + pv3W + pv4W\n    }\n  };\n\n  flow.set(\"power_part_pv\", part);\n}\n\n// Grid 169\nelse if (baseAddr === 169) {\n  const gridW = s16(data[0]);\n  flow.set(\"power_part_grid\", { grid: { totalPowerW: gridW } });\n}\n\n// Load 178\nelse if (baseAddr === 178) {\n  const loadW = s16(data[0]);\n  flow.set(\"power_part_load\", { load: { totalPowerW: loadW } });\n}\n\n// Battery 190\nelse if (baseAddr === 190) {\n  const battW = s16(data[0]);\n  flow.set(\"power_part_batt\", { battery: { powerW: battW } });\n}\n\n// Generator 166\nelse if (baseAddr === 166) {\n  const genW = s16(data[0]);\n  flow.set(\"power_part_gen\", { generator: { totalPowerW: genW } });\n}\nelse {\n  return null;\n}\n\n// ---- Try to assemble full state ----\n\nconst pvPart = flow.get(\"power_part_pv\");\nconst gridPart = flow.get(\"power_part_grid\");\nconst loadPart = flow.get(\"power_part_load\");\nconst battPart = flow.get(\"power_part_batt\");\nconst genPart = flow.get(\"power_part_gen\");\n\n// Require at least PV + grid + load + battery; generator is optional\nif (!pvPart || !gridPart || !loadPart || !battPart) {\n  return null;\n}\n\n// Resolve DeviceId\nconst deviceId = msg.deviceId\n  || global.get(\"DEVICE_ID\")\n  || env.get(\"DEVICE_ID\")\n  || \"EC100-DEV-001\";\n\nconst state = {\n  kind: \"PowerFlowState\",\n  timestampUtc: new Date().toISOString(),\n  version: 1,\n  DeviceId: deviceId,\n\n  pv: pvPart.pv,\n  grid: gridPart.grid,\n  load: loadPart.load,\n  battery: battPart.battery,\n  generator: genPart ? genPart.generator : { totalPowerW: 0 }\n};\n\n// Keep snapshot in flow as before\nflow.set(\"powerFlowSnapshot\", state);\n\n// Put result on msg\nmsg.payload = state;\nmsg.state = state;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

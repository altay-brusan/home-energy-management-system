        "type": "function",
        "z": "load_device_state_tab",
        "name": "Prepare read (Daily/Total 84-86)",
        "func": "// Daily and Total load energy\n// 84: Day_Load_Power (0.1kWh)\n// 85: Total_Load_Power Low (0.1kWh)\n// 86: Total_Load_Power High (0.1kWh)\n\nmsg.baseAddr = 84;\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 84,\n    quantity: 3\n};\nreturn msg;",

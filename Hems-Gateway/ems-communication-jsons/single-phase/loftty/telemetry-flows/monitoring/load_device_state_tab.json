    {
        "id": "lds_build_json",
        "type": "function",
        "z": "load_device_state_tab",
        "name": "Build LoadDeviceState JSON",
        "func": "// Build LoadDeviceState from multiple Modbus reads.\n\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nlet baseAddr = msg.baseAddr;\nif (typeof baseAddr !== \"number\") {\n    baseAddr = (msg.modbusRequest && msg.modbusRequest.address);\n}\nif (typeof baseAddr !== \"number\") {\n    node.warn(\"LoadDeviceState: missing base address\");\n    return null;\n}\n\n// Helper: signed 16-bit\nfunction s16(v) {\n    if (!Number.isFinite(v)) return null;\n    return (v & 0x8000) ? v - 0x10000 : v;\n}\n\n// Helper: combine two 16-bit words to 32-bit unsigned\nfunction u32(low, high) {\n    return ((high & 0xFFFF) << 16) | (low & 0xFFFF);\n}\n\n// ---- Store partials ----\n\n// Daily/Total 84-86\nif (baseAddr === 84) {\n    const dailyRaw = data[0] || 0;      // 84: Day Load (0.1kWh)\n    const totalLow = data[1] || 0;      // 85: Total Low\n    const totalHigh = data[2] || 0;     // 86: Total High\n    \n    const dailyKWh = Math.round(dailyRaw * 0.1 * 10) / 10;\n    const totalKWh = Math.round(u32(totalLow, totalHigh) * 0.1 * 10) / 10;\n    \n    flow.set(\"lds_part_energy\", {\n        todayEnergyKWh: dailyKWh,\n        totalEnergyKWh: totalKWh\n    });\n}\n\n// Voltage 157\nelse if (baseAddr === 157) {\n    const voltageRaw = data[0] || 0;  // 0.1V\n    flow.set(\"lds_part_voltage\", {\n        voltageV: Math.round(voltageRaw * 0.1 * 10) / 10\n    });\n}\n\n// Power 178\nelse if (baseAddr === 178) {\n    const powerRaw = s16(data[0]);  // 1W, signed\n    flow.set(\"lds_part_power\", {\n        activePowerW: powerRaw\n    });\n}\n\n// Frequency 192\nelse if (baseAddr === 192) {\n    const freqRaw = data[0] || 0;  // 0.01Hz\n    flow.set(\"lds_part_freq\", {\n        frequencyHz: Math.round(freqRaw * 0.01 * 100) / 100\n    });\n}\nelse {\n    return null;\n}\n\n// ---- Try to assemble ----\n\nconst energyPart = flow.get(\"lds_part_energy\");\nconst voltagePart = flow.get(\"lds_part_voltage\");\nconst powerPart = flow.get(\"lds_part_power\");\nconst freqPart = flow.get(\"lds_part_freq\");\n\nif (!energyPart || !voltagePart || !powerPart || !freqPart) {\n    return null;\n}\n\nconst deviceId = msg.deviceId\n    || global.get(\"DEVICE_ID\")\n    || env.get(\"DEVICE_ID\")\n    || \"EC100-DEV-001\";\n\nconst state = {\n    kind: \"LoadDeviceState\",\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    DeviceId: deviceId,\n    \n    scope: \"backup_load\",\n    \n    activePowerW: powerPart.activePowerW,\n    apparentPowerVA: null,  // Not available separately for load\n    \n    voltageV: voltagePart.voltageV,\n    frequencyHz: freqPart.frequencyHz,\n    \n    todayEnergyKWh: energyPart.todayEnergyKWh,\n    totalEnergyKWh: energyPart.totalEnergyKWh\n};\n\n// Clear partials\nflow.set(\"lds_part_energy\", null);\nflow.set(\"lds_part_voltage\", null);\nflow.set(\"lds_part_power\", null);\nflow.set(\"lds_part_freq\", null);\n\nflow.set(\"loadDeviceStateSnapshot\", state);\n\nmsg.payload = state;\nmsg.state = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 160,
        "wires": [

GridCodeConfigState {
  "timestampUtc": string,
  "gatewayId": string,
  "inverterSerialNumber": string,
  "version": string,

  // --- Basic grid profile (high-level) ---

  "gridModeRaw": number,              // 284: Grid Mode (0=general, 1=UL1741, 2=CPUC RULE21, 3=SRD-UL1741...)
  "gridFrequencyHz": number,          // 285: Grid Frequency (0=50Hz, 1=60Hz)
  "gridVoltageLevelCode": number,     // 286: Grid Type (0=single 240V, 1=split 120/240V, 2=three-phase 208V, 3=120V single)

  "normalConnect": {
    "voltageLowV": number,            // 288: Grid Vol Low (0.1V)
    "voltageHighV": number,           // 287: Grid Vol High (0.1V)
    "frequencyLowHz": number,         // 290: Grid Hz Low (0.01Hz)
    "frequencyHighHz": number         // 289: Grid Hz High (0.01Hz)
  },

  "reconnectionTimeSeconds": number,  // 282: Restore connection time (10-300 seconds)

  "powerFactorTarget": number,        // 39: Power factor regulation (0-2000, offset +1000)
  "activePowerRegulationPercentPerStep": number,   // 40: Active power regulation (0.1%)
  "reactivePowerRegulationPercentPerStep": number  // 41: Reactive power regulation (0.1%)
}
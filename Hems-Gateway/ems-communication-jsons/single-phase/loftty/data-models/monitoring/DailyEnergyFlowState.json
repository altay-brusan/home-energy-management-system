      { "id": 1, "energyKWh": number },     // not available in this protocol - use total
      { "id": 2, "energyKWh": number },     // not available in this protocol - use total
      { "id": 3, "energyKWh": number },     // not available in this protocol - use total
      { "id": 4, "energyKWh": number }      // not available in this protocol - use total
    ]
  },

  "battery": {
    "chargeEnergyKWh": number,              // 70 (Day_Batt_Charge_PowerWh) 0.1kWh
    "dischargeEnergyKWh": number            // 71 (Day_Batt_Discharge_PowerWh) 0.1kWh
  },

  "generator": {
    "energyKWh": number                     // 62 (Today_Gen_PowerWh) 0.1kWh
  }
}
    {
        "id": "parse_hvcu_control",
        "type": "function",
        "z": "hvcu_control_state_tab",
        "name": "Parse HVCU Control State",
        "func": "const frame = msg.payload || msg;\nlet canId = frame.canid & 0x1FFFFFFF;\nconst data = frame.data || [];\n\n// HVCU_Control_State (0x18FF201Ex)\n// CAN ID pattern: 0x18FF2010 - 0x18FF201F\nif ((canId & 0xFFFFFFF0) !== 0x18FF2010) {\n    return null;\n}\n\n// Helper functions\nfunction u8(buf, offset) {\n    return buf[offset] & 0xFF;\n}\n\nfunction getBit(buf, byteOffset, bitOffset) {\n    return ((buf[byteOffset] >> bitOffset) & 0x01) === 1;\n}\n\n// State code to string mapping\nconst stateMap = {\n    0: \"N/A\",\n    101: \"Standby\",\n    102: \"Startup\",\n    103: \"Precharge\",\n    104: \"Discharge\",\n    105: \"Charge\",\n    106: \"Shutdown\"\n};\n\nlet state = {\n    kind: \"HVCUControlState\",\n    version: 1,\n    timestampUtc: new Date().toISOString(),\n    \n    // Bit 0-7: BCU 01 Control State\n    bcu01ControlStateCode: u8(data, 0),\n    bcu01ControlState: stateMap[u8(data, 0)] || \"Unknown\",\n    \n    // Bit 8-15: BCU 02 Control State\n    bcu02ControlStateCode: u8(data, 1),\n    bcu02ControlState: stateMap[u8(data, 1)] || \"Unknown\",\n    \n    // Bit 16-23: BCU 03 Control State\n    bcu03ControlStateCode: u8(data, 2),\n    bcu03ControlState: stateMap[u8(data, 2)] || \"Unknown\",\n    \n    // Bit 24-31: BCU 04 Control State\n    bcu04ControlStateCode: u8(data, 3),\n    bcu04ControlState: stateMap[u8(data, 3)] || \"Unknown\",\n    \n    // Bit 32: Pack1 Isolation Control\n    pack1IsolationControl: getBit(data, 4, 0)\n};\n\nflow.set(\"hvcuControlState\", state);\nmsg.payload = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 180,
        "wires": [
            [
                "debug_hvcu_control",
                "throttle_hvcu_control"
            ]
        ]
    },

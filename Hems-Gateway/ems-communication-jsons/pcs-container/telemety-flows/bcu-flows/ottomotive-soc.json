    {
        "id": "parse_pcs_soc",
        "type": "function",
        "z": "pcs_soc_tab",
        "name": "Parse PCS SOC",
        "func": "const frame = msg.payload || msg;\nlet canId = frame.canid & 0x1FFFFFFF;\nconst data = frame.data || [];\n\n// 0x18FF14F0: 00 64 00 00 01 00 1B 76\n//             ↑\n//          Byte 0 = SOC\n//          8 bit, Factor: 1, Offset: 0\n\nif (canId === 0x18FF14F0) {\n    let state = flow.get(\"pcsSoc\") || {\n        kind: \"PcsSocState\",\n        version: 1,\n        socPercent: null\n    };\n    \n    // SOC = (raw * factor) + offset = raw * 1 + 0 = raw\n    state.socPercent = data[0] & 0xFF;\n    state.timestampUtc = new Date().toISOString();\n    \n    flow.set(\"pcsSoc\", state);\n    msg.payload = state;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 140,
        "wires": [
            [
                "debug_pcs_soc",
                "throttle_pcs_soc"
            ]
        ]
    },

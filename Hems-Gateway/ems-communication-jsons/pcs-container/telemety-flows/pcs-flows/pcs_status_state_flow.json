    {
        "id": "parse_pcs_status",
        "type": "function",
        "z": "pcs_status_state_tab",
        "name": "Parse PCS Status State",
        "func": "const frame = msg.payload || msg;\nlet canId = frame.canid & 0x1FFFFFFF;\nconst data = frame.data || [];\n\n// Only process PCS_STATUS_MAIN (0x66B969x)\nif ((canId & 0xFFFFFFF0) !== 0x66B9690) {\n    return null;\n}\n\n// Helper functions\nfunction u8(buf, offset) {\n    return buf[offset] & 0xFF;\n}\n\nfunction s16(buf, offset) {\n    let val = (buf[offset] & 0xFF) | ((buf[offset + 1] & 0xFF) << 8);\n    return val > 32767 ? val - 65536 : val;\n}\n\nlet state = {\n    kind: \"PcsStatusState\",\n    version: 1,\n    timestampUtc: new Date().toISOString(),\n    \n    // Bit 0-15: Grid Frequency\n    // 16 bit, Signed, Factor: 0.01, Offset: 0, Unit: Hz\n    // Min: 0, Max: 100\n    pcs_gridFreqHz: s16(data, 0) * 0.01,\n    \n    // Bit 16-23: Grid Phase Sequence\n    // 8 bit, Unsigned, Factor: 1, Offset: 0\n    // Min: 0, Max: 3\n    pcs_gridPhaseSeq: u8(data, 2),\n    \n    // Bit 24-31: Derating Coefficient\n    // 8 bit, Unsigned, Factor: 0.01, Offset: 0\n    // Min: 0, Max: 1.27\n    pcs_deratCoeff: u8(data, 3) * 0.01,\n    \n    // Bit 32-39: Derating Mark\n    // 8 bit, Unsigned, Factor: 1, Offset: 0\n    // Min: 0, Max: 3\n    pcs_deratMark: u8(data, 4),\n    \n    // Bit 40-47: Working Condition\n    // 8 bit, Unsigned, Factor: 1, Offset: 0\n    // Min: 0, Max: 7\n    pcs_workingCondition: u8(data, 5),\n    \n    // Bit 48-55: Source Mode\n    // 8 bit, Unsigned, Factor: 1, Offset: 0\n    // Min: 0, Max: 3\n    pcs_sourceMode: u8(data, 6),\n    \n    // Bit 56-63: Grid Mode\n    // 8 bit, Unsigned, Factor: 1, Offset: 0\n    // Min: 0, Max: 15\n    pcs_gridMode: u8(data, 7)\n};\n\nflow.set(\"pcsStatusState\", state);\nmsg.payload = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 180,
        "wires": [
            [
                "debug_pcs_status",
                "throttle_pcs_status"
            ]
        ]
    },

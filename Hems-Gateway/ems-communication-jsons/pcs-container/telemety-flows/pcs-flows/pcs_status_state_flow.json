        "info": "PcsStatusState - PCS Status Main\n\nCAN Message:\n- 0x66B969x: PCS_STATUS_MAIN\n\nThrottle: 5s"
    },
    {
        "id": "can0_input_pcs_status",
        "type": "socketcan-out",
        "z": "pcs_status_state_tab",
        "name": "CAN0 Input",
        "config": "537471527fc35bc4",
        "x": 120,
        "y": 180,

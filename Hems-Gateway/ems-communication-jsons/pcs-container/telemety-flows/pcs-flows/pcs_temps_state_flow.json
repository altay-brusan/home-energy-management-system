    {
        "id": "get_pcs_temps",
        "type": "function",
        "z": "pcs_temps_state_tab",
        "name": "Get State from Context",
        "func": "var state = flow.get(\"pcsTempsState\");\nif (state) {\n    msg.payload = state;\n    return msg;\n}\nmsg.payload = { error: \"No data yet\" };\nreturn msg;",
        "outputs": 1,
        "timeout": "",

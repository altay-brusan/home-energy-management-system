    {
        "id": "parse_soc_state",
        "type": "function",
        "z": "soc_state_tab",
        "name": "Parse SOC & State",
        "func": "const frame = msg.payload || msg;\nlet canId = frame.canid;\nconst data = frame.data || [];\n\n// Extended frame flag'i temizle (0x80000000)\ncanId = canId & 0x1FFFFFFF;\n\nlet state = flow.get(\"containerSocState\") || {\n    kind: \"ContainerSocState\",\n    version: 1,\n    socPercent: null,\n    stateCode: null,\n    state: null\n};\n\n// Helper function\nfunction u8(buf, offset) {\n    return buf[offset] & 0xFF;\n}\n\n// State code to string mapping\nconst stateMap = {\n    0: \"N/A\",\n    101: \"Standby\",\n    102: \"Startup\",\n    103: \"Precharge\",\n    104: \"Discharge\",\n    105: \"Charge\",\n    106: \"Shutdown\",\n    107: \"Fault\",\n    108: \"Charge_Complete\",\n    109: \"Discharge_Complete\"\n};\n\nvar processed = false;\n\n// BCU_01_Battery_Status (0x98F706F0 = 2566853872)\n// SOC: Byte 0, 8 bit, scale 1, offset 0\nif (canId === 0x18F706F0 || canId === 0x98F706F0) {\n    processed = true;\n    state.socPercent = u8(data, 0);  // 0|8@1+ (1,0) [0|100] \"%\"\n}\n\n// BCU_01_Output_Status (0x98F705F0 = 2566852848)\n// State: Byte 0, 8 bit\nif (canId === 0x18F705F0 || canId === 0x98F705F0) {\n    processed = true;\n    state.stateCode = u8(data, 0);  // 0|8@1+ (1,0) [0|255]\n    state.state = stateMap[state.stateCode] || \"Unknown\";\n}\n\nif (!processed) {\n    return null;\n}\n\nstate.timestampUtc = new Date().toISOString();\nflow.set(\"containerSocState\", state);\nmsg.payload = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 140,
        "wires": [
            [
                "debug_soc_state",
                "throttle_soc_state"
            ]
        ]
    },

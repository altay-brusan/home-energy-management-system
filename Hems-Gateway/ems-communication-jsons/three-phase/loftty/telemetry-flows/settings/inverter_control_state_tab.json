    {
        "id": "91dbcc76e12879bd",
        "type": "function",
        "z": "3afae91305af8e57",
        "name": "Queue Writes",
        "func": "// Parse RPC params and build write queue\nconst params = msg.rpcParams || {};\n\nconst writes = [];\n\n// Register 160: remoteLock\nif (params.remoteLock !== undefined) {\n    const val = params.remoteLock === \"locked\" ? 0x0002 : 0x0000;\n    writes.push({ register: 160, value: val, name: \"Remote Lock\" });\n}\n\n// Register 180: powerSwitch\nif (params.powerSwitch !== undefined) {\n    writes.push({ register: 180, value: params.powerSwitch, name: \"Power Switch\" });\n}\n\n// Register 181: factoryResetEnabled\nif (params.factoryResetEnabled !== undefined) {\n    const val = params.factoryResetEnabled ? 1 : 0;\n    writes.push({ register: 181, value: val, name: \"Factory Reset\" });\n}\n\n// Register 183: islandProtectionEnabled\nif (params.islandProtectionEnabled !== undefined) {\n    const val = params.islandProtectionEnabled ? 1 : 0;\n    writes.push({ register: 183, value: val, name: \"Island Protection\" });\n}\n\nif (writes.length === 0) {\n    msg.operationType = 'read';\n    return [null, msg];\n}\n\n// Store to GLOBAL context\nglobal.set(\"ics_write_queue\", writes);\nglobal.set(\"ics_write_index\", 0);\nglobal.set(\"ics_write_results\", []);\nglobal.set(\"ics_write_rpc_topic\", msg.rpcResponseTopic);\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: `${writes.length} writes queued` });\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 480,
        "wires": [
            [
                "f7bfc13e51fde18a"
            ],
            [
                "b0cb6db0190461dc"
            ]
        ]
    },
    {
        "id": "f7bfc13e51fde18a",
        "type": "function",
        "z": "3afae91305af8e57",
        "name": "Prepare Write",
        "func": "const writes = global.get(\"ics_write_queue\") || [];\nconst index = global.get(\"ics_write_index\") || 0;\n\nif (index >= writes.length) {\n    return null;\n}\n\nconst current = writes[index];\n\nconst newMsg = {\n    payload: {\n        fc: 16,\n        unitid: 1,\n        address: current.register,\n        quantity: 1,\n        value: [current.value]\n    },\n    currentWrite: current,\n    writeIndex: index\n};\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: `[${index+1}/${writes.length}] ${current.name}` });\n\nreturn newMsg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 480,

    {
        "id": "ccebe1eecb4f732a",
        "type": "function",
        "z": "3afae91305af8e57",
        "name": "Write OK",
        "func": "const writes = global.get(\"ics_write_queue\") || [];\nlet index = global.get(\"ics_write_index\") || 0;\nconst results = global.get(\"ics_write_results\") || [];\n\n// Record success\nconst current = writes[index];\nif (current) {\n    results.push({ \n        register: current.register, \n        name: current.name, \n        value: current.value, \n        success: true \n    });\n    global.set(\"ics_write_results\", results);\n}\n\n// Move to next\nindex++;\nglobal.set(\"ics_write_index\", index);\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `${current.name} OK` });\n\n// More writes?\nif (index < writes.length) {\n    return [{ doNext: true }, null];\n}\n\n// All done - go to read\nconst rpcTopic = global.get(\"ics_write_rpc_topic\");\n\nglobal.set(\"ics_write_queue\", null);\nglobal.set(\"ics_write_index\", null);\nglobal.set(\"ics_write_rpc_topic\", null);\n\nconst finalMsg = {\n    writeResult: {\n        success: true,\n        message: `Successfully wrote ${results.length} register(s)`,\n        writes: results\n    },\n    rpcResponseTopic: rpcTopic\n};\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `All ${results.length} writes OK!` });\n\nreturn [null, finalMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,

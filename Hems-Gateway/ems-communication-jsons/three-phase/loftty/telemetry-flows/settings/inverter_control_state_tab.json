    {
        "id": "aa32be3df34b5676",
        "type": "function",
        "z": "3afae91305af8e57",
        "name": "Build JSON State",
        "func": "// Store 183 data\nlet data = msg.payload;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\nconst reg183 = data[0];\n\n// Get all stored registers\nconst reg160 = flow.get('ics_reg160');\nconst reg180 = flow.get('ics_reg180');\nconst reg181 = flow.get('ics_reg181');\n\n// Clear flow context\nflow.set('ics_reg160', null);\nflow.set('ics_reg180', null);\nflow.set('ics_reg181', null);\n\nconst gatewayId = global.get(\"GATEWAY_ID\") || env.get(\"GATEWAY_ID\") || \"EC100-GW-001\";\n\nconst state = {\n    kind: \"InverterControlState\",\n    timestampUtc: new Date().toISOString(),\n    gatewayId: gatewayId,\n    version: 1,\n    \n    remoteLock: reg160 === 0x0002 ? \"locked\" : \"unlocked\",\n    powerSwitch: reg180 || 0,\n    factoryResetEnabled: reg181 === 1,\n    islandProtectionEnabled: reg183 === 1\n};\n\nconst writeResult = flow.get(\"ics_write_result\");\nconst rpcResponseTopic = flow.get(\"ics_rpc_response_topic\");\n\nflow.set(\"ics_write_result\", null);\nflow.set(\"ics_rpc_response_topic\", null);\n\nif (writeResult) {\n    msg.payload = {\n        success: writeResult.success,\n        message: writeResult.message,\n        writes: writeResult.writes,\n        state: state\n    };\n} else {\n    msg.payload = state;\n}\n\nmsg.state = state;\nmsg.rpcResponseTopic = rpcResponseTopic;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `Lock: ${state.remoteLock}, Power: ${state.powerSwitch}` });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1270,
        "y": 280,
        "wires": [
            [
                "eafb4423c007eb6c",
                "2096e3fa0e685625"
            ]
        ]
    },

    {
        "id": "8b7fbec5626e0bea",
        "type": "function",
        "z": "3874bba10065de29",
        "name": "Build Read Response",
        "func": "let data = msg.payload;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (!Array.isArray(data) || data.length < 1) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"Read failed\" });\n    return null;\n}\n\nconst code = data[0];\n\nconst strategyMap = {\n    0: \"selling_first\",\n    1: \"zero_export_to_load\",\n    2: \"zero_export_to_ct\"\n};\n\nconst strategy = strategyMap[code] || \"unknown\";\n\nconst gatewayId = global.get(\"GATEWAY_ID\") || env.get(\"GATEWAY_ID\") || \"EC100-GW-001\";\n\nconst state = {\n    kind: \"ExportStrategyState\",\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    gatewayId: gatewayId,\n    exportStrategy: strategy,\n    exportStrategyCode: code\n};\n\nmsg.payload = state;\nmsg.state = state;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: strategy });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

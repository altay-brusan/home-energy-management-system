    {
        "id": "b9e111eda41ff1b2",
        "type": "function",
        "z": "3874bba10065de29",
        "name": "Prep Write Reg 242",
        "func": "const params = msg.rpcParams || {};\n\nconst strategyToCode = {\n    \"selling_first\": 0,\n    \"zero_export_to_load\": 1,\n    \"zero_export_to_ct\": 2\n};\n\nlet code = null;\n\n// Accept both string and code\nif (params.exportStrategy !== undefined) {\n    code = strategyToCode[params.exportStrategy];\n} else if (params.exportStrategyCode !== undefined) {\n    code = params.exportStrategyCode;\n}\n\nif (code === null || code === undefined) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"Invalid params\" });\n    node.error(\"Missing exportStrategy or exportStrategyCode\");\n    return null;\n}\n\nconst codeToStrategy = {\n    0: \"selling_first\",\n    1: \"zero_export_to_load\",\n    2: \"zero_export_to_ct\"\n};\n\nmsg.writeInfo = {\n    code: code,\n    strategy: codeToStrategy[code] || \"unknown\"\n};\n\nmsg.payload = {\n    fc: 16,\n    unitid: 1,\n    address: 242,\n    quantity: 1,\n    value: [code]\n};\n\nnode.status({ fill: \"yellow\", shape: \"dot\", text: \"Writing: \" + msg.writeInfo.strategy });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

    {
        "id": "db75ab1daa9dafa9",
        "type": "function",
        "z": "3874bba10065de29",
        "name": "Build Write Response",
        "func": "// Filter out confirmation messages\nconst isConfirmation = msg.payload && \n                       msg.payload.address !== undefined && \n                       msg.payload.length !== undefined &&\n                       !msg.payload.error;\n\nif (isConfirmation) {\n    return null;\n}\n\nconst writeInfo = msg.writeInfo || { code: -1, strategy: 'unknown' };\nconst gatewayId = global.get(\"GATEWAY_ID\") || env.get(\"GATEWAY_ID\") || \"EC100-GW-001\";\n\nconst state = {\n    kind: \"ExportStrategyState\",\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    gatewayId: gatewayId,\n    success: true,\n    message: \"Export strategy updated\",\n    exportStrategy: writeInfo.strategy,\n    exportStrategyCode: writeInfo.code\n};\n\nmsg.payload = state;\nmsg.state = state;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"OK: \" + writeInfo.strategy });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,

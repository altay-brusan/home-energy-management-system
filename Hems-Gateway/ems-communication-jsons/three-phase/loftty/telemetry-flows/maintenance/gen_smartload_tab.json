    {
        "id": "48d65c0023159749",
        "type": "function",
        "z": "e3f9191e40666dea",
        "name": "Prep Write Reg 232",
        "func": "const params = msg.rpcParams || {};\n\nlet code = null;\n\nif (params.forceSmartLoadOn !== undefined) {\n    code = params.forceSmartLoadOn ? 1 : 0;\n}\n\nif (code === null || code === undefined) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"Invalid params\" });\n    node.error(\"Missing forceSmartLoadOn parameter\");\n    return null;\n}\n\nmsg.writeInfo = {\n    code: code,\n    enabled: code === 1\n};\n\nmsg.payload = {\n    fc: 16,\n    unitid: 1,\n    address: 232,\n    quantity: 1,\n    value: [code]\n};\n\nnode.status({ fill: \"yellow\", shape: \"dot\", text: \"Writing: \" + (code === 1 ? \"Force ON\" : \"Force OFF\") });\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

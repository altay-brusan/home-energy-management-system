    {
        "id": "25376e41f4d9ca36",
        "type": "function",
        "z": "e06e9ef7e85e5c21",
        "name": "Build PowerFlowState JSON",
        "func": "// Build PowerFlowState from 8 parallel Modbus reads.\n\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nlet baseAddr = msg.baseAddr;\nif (typeof baseAddr !== \"number\") {\n    baseAddr = (msg.modbusRequest && msg.modbusRequest.address);\n}\nif (typeof baseAddr !== \"number\") {\n    node.warn(\"PowerFlowState: missing base address\");\n    return null;\n}\n\n// Helper: convert unsigned 16-bit to signed\nfunction toSigned16(val) {\n    if (val > 32767) {\n        return val - 65536;\n    }\n    return val;\n}\n\n// Helper: combine two 16-bit words to 32-bit signed\nfunction s32(low, high) {\n    const combined = (high << 16) | low;\n    return combined > 0x7FFFFFFF ? combined - 0x100000000 : combined;\n}\n\n// ---- Store partials based on baseAddr ----\n\nif (baseAddr === 772) {\n    // PV powers\n    flow.set(\"pfs_pv_powers\", {\n        pv1: data[0] || 0,\n        pv2: data[1] || 0,\n        pv3: data[2] || 0,\n        pv4: data[3] || 0\n    });\n} else if (baseAddr === 690) {\n    // Battery (S16)\n    flow.set(\"pfs_battery\", toSigned16(data[0] || 0));\n} else if (baseAddr === 725) {\n    // Grid low\n    flow.set(\"pfs_grid_low\", data[0] || 0);\n} else if (baseAddr === 790) {\n    // Grid high\n    flow.set(\"pfs_grid_high\", data[0] || 0);\n} else if (baseAddr === 753) {\n    // Load low\n    flow.set(\"pfs_load_low\", data[0] || 0);\n} else if (baseAddr === 759) {\n    // Load high\n    flow.set(\"pfs_load_high\", data[0] || 0);\n} else if (baseAddr === 767) {\n    // Gen low\n    flow.set(\"pfs_gen_low\", data[0] || 0);\n} else if (baseAddr === 771) {\n    // Gen high\n    flow.set(\"pfs_gen_high\", data[0] || 0);\n} else {\n    return null;\n}\n\n// ---- Try to assemble ----\n\nconst pvPowers = flow.get(\"pfs_pv_powers\");\nconst battery = flow.get(\"pfs_battery\");\nconst gridLow = flow.get(\"pfs_grid_low\");\nconst gridHigh = flow.get(\"pfs_grid_high\");\nconst loadLow = flow.get(\"pfs_load_low\");\nconst loadHigh = flow.get(\"pfs_load_high\");\nconst genLow = flow.get(\"pfs_gen_low\");\nconst genHigh = flow.get(\"pfs_gen_high\");\n\nif (!pvPowers || battery === undefined || \n    gridLow === undefined || gridHigh === undefined ||\n    loadLow === undefined || loadHigh === undefined ||\n    genLow === undefined || genHigh === undefined) {\n    return null;\n}\n\n// Combine S32 values\nconst gridPower = s32(gridLow, gridHigh);\nconst loadPower = s32(loadLow, loadHigh);\nconst genPower = s32(genLow, genHigh);\nconst pvTotal = (pvPowers.pv1 || 0) + (pvPowers.pv2 || 0) + \n                (pvPowers.pv3 || 0) + (pvPowers.pv4 || 0);\n\nconst deviceId = msg.deviceId\n    || global.get(\"DEVICE_ID\")\n    || env.get(\"DEVICE_ID\")\n    || \"EC100\";\n\nconst state = {\n    kind: \"PowerFlowState\",\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    DeviceId: deviceId,\n    \n    pv: {\n        totalPowerW: pvTotal,\n        mppt: [\n            { id: 1, powerW: pvPowers.pv1 || 0 },\n            { id: 2, powerW: pvPowers.pv2 || 0 },\n            { id: 3, powerW: pvPowers.pv3 || 0 },\n            { id: 4, powerW: pvPowers.pv4 || 0 },\n            { id: 5, powerW: null },\n            { id: 6, powerW: null },\n            { id: 7, powerW: null },\n            { id: 8, powerW: null }\n        ]\n    },\n    \n    grid: {\n        totalPowerW: gridPower\n    },\n    \n    load: {\n        totalPowerW: loadPower\n    },\n    \n    battery: {\n        powerW: battery\n    },\n    \n    generator: {\n        totalPowerW: genPower\n    }\n};\n\n// Clear partials\nflow.set(\"pfs_pv_powers\", null);\nflow.set(\"pfs_battery\", null);\nflow.set(\"pfs_grid_low\", null);\nflow.set(\"pfs_grid_high\", null);\nflow.set(\"pfs_load_low\", null);\nflow.set(\"pfs_load_high\", null);\nflow.set(\"pfs_gen_low\", null);\nflow.set(\"pfs_gen_high\", null);\n\nflow.set(\"powerFlowStateSnapshot\", state);\n\nmsg.payload = state;\nmsg.state = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

    {
        "id": "irs_tab_001",
        "type": "tab",
        "label": "InverterRunState",
        "disabled": false,
        "info": "Reads Inverter Run State from register 600.\n\nRun State Values:\n- 0 = standby\n- 1 = selfcheck\n- 2 = normal\n- 3 = alarm\n- 4 = fault\n\nTriggers:\n1. RPC: getInverterRunState (always sends)\n2. Cron: Every 1 minute (sends only on state change)\n3. Manual inject"
    },

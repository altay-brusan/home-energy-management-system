    {
        "id": "9aec6591e27ef9a3",
        "type": "function",
        "z": "ca20456a2fa7f6a8",
        "name": "Build InverterRunState JSON",
        "func": "// Build InverterRunState JSON\n\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nconst runStateCode = data[0] || 0;\n\n// Map run state code to string\nfunction mapRunState(code) {\n    const states = {\n        0: \"standby\",\n        1: \"selfcheck\",\n        2: \"normal\",\n        3: \"alarm\",\n        4: \"fault\"\n    };\n    return states[code] || \"unknown\";\n}\n\nconst state = {\n    kind: \"InverterRunState\",\n    version: 1,\n    runState: mapRunState(runStateCode)\n};\n\nmsg.payload = state;\nmsg.runState = state.runState;\n\n// Route: RPC goes to output 1, Cron goes to output 2\nconst isRpc = msg.isRpc === true;\n\nif (isRpc) {\n    return [msg, null];\n} else {\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 100,
        "wires": [
            [
                "51311720ca73e5ab",
                "ed055b76e53cacfa"
            ],
            [
                "f5e65ece65ed69e5"
            ]
        ]
    },
    {
        "id": "51311720ca73e5ab",
        "type": "function",
        "z": "ca20456a2fa7f6a8",
        "name": "RPC Response Handler",
        "func": "// Handle RPC response - always send\nconst rpcTopic = flow.get(\"irs_rpc_response_topic\");\n\nif (rpcTopic) {\n    // RPC request - send response\n    msg.topic = rpcTopic;\n    msg.payload = { success: true, data: msg.payload };\n    flow.set(\"irs_rpc_response_topic\", null);\n    return [msg, null];\n} else {\n    // Manual trigger - send to ThingsBoard\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,
        "y": 60,
        "wires": [
            [
                "100a250f25a44ac9"
            ],
            [
                "c04ae0cc2c50ed8f"
            ]
        ]
    },
    {
        "id": "f5e65ece65ed69e5",
        "type": "function",
        "z": "ca20456a2fa7f6a8",
        "name": "Check if should send",
        "func": "// Check if state changed - only send on change\nconst currentState = msg.runState;\nconst lastState = flow.get(\"irs_last_run_state\");\n\nif (lastState === undefined || lastState !== currentState) {\n    // State changed or first read - send\n    flow.set(\"irs_last_run_state\", currentState);\n    node.status({ fill: \"green\", shape: \"dot\", text: \"Sending: \" + currentState });\n    return msg;\n} else {\n    // No change - don't send\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"No change: \" + currentState });\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1140,
        "y": 140,
        "wires": [
            [
                "c04ae0cc2c50ed8f"
            ]
        ]
    },

    {
        "id": "8beec566bb59c2ef",
        "type": "function",
        "z": "ca20456a2fa7f6a8",
        "name": "Prepare read (RPC)",
        "func": "// Store RPC response topic if present\nif (msg.rpcResponseTopic) {\n    flow.set(\"irs_rpc_response_topic\", msg.rpcResponseTopic);\n}\n\n// Mark as RPC request (always send)\nmsg.isRpc = true;\n\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 600,\n    quantity: 1\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 60,

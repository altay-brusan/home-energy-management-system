        "type": "function",
        "z": "ca20456a2fa7f6a8",
        "name": "Prepare read (Cron)",
        "func": "// Mark as Cron request (send only on change)\nmsg.isRpc = false;\n\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 600,\n    quantity: 1\n};\nreturn msg;",
        "outputs": 1,

    {
        "id": "bss_rpc_response",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Prepare RPC Response",
        "func": "// Only respond if this came from RPC\nif (!msg.rpcResponseTopic) {\n    return null;\n}\n\nconst state = msg.state || msg.payload;\n\nmsg.payload = state;\nmsg.topic = msg.rpcResponseTopic;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

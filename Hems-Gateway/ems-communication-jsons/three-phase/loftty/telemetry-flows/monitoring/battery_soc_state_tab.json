    {
        "id": "bss_prepare_read",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Prepare read (SOC 688)",
        "func": "// Battery SOC\n// 688: Battery capacity %\n\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 688,\n    quantity: 1\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 160,
        "wires": [
            [
                "bss_modbus_read"
            ]
        ]
    },
    {
        "id": "bss_modbus_read",
        "type": "modbus-flex-getter",
        "z": "battery_soc_state_tab",
        "name": "Read SOC (688)",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "logIOActivities": false,
        "server": "e4e4f3e2a4f4e004",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": true,
        "keepMsgProperties": true,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 700,
        "y": 160,

                "bss_build_json"
            ],
            [
                "bss_error_debug"
            ]
        ]
    },
    {
        "id": "bss_build_json",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Build BatterySocState JSON",
        "func": "// Build BatterySocState from Modbus read.\n\nlet raw = msg.payload;\nlet data = raw;\nif (data && Array.isArray(data.data)) {\n    data = data.data;\n}\n\nif (typeof raw === \"string\" || !Array.isArray(data)) {\n    return null;\n}\n\nconst socPercent = data[0] || 0;  // 688: Battery capacity %\n\nconst deviceId = msg.deviceId\n    || global.get(\"DEVICE_ID\")\n    || env.get(\"DEVICE_ID\")\n    || \"EC100-DEV-001\";\n\nconst state = {\n    kind: \"BatterySocState\",\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    DeviceId: deviceId,\n    \n    inverterBatChannelSoc: [\n        {\n            channelId: 1,\n            socPercent: socPercent\n        },\n        {\n            channelId: 2,\n            socPercent: null  // Three-phase only has 1 channel\n        }\n    ],\n    \n    bmsSocDetails: null  // Not available in three-phase datasheet\n};\n\n// Store current SOC for change detection\nmsg.currentSocPercent = socPercent;\n\n// Get previous SOC value\nmsg.previousSocPercent = flow.get(\"lastSocPercent\");\n\n// Update stored value\nflow.set(\"lastSocPercent\", socPercent);\n\n// Store snapshot\nflow.set(\"batterySocStateSnapshot\", state);\n\nmsg.payload = state;\nmsg.state = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 160,
        "wires": [
            [
                "bss_check_change"
            ]
        ]
    },
    {
        "id": "bss_check_change",
        "type": "function",
        "z": "battery_soc_state_tab",
        "name": "Check SOC Change",
        "func": "// Check if SOC value has changed\n// RPC requests always get response\n// Periodic polls only send to ThingsBoard if value changed\n\nconst currentSoc = msg.currentSocPercent;\nconst previousSoc = msg.previousSocPercent;\nconst isRpc = msg.isRpcRequest === true;\n\n// Determine if SOC changed\n// First read (previousSoc undefined/null) counts as changed\nconst socChanged = (previousSoc === undefined || previousSoc === null || currentSoc !== previousSoc);\n\nmsg.socChanged = socChanged;\n\n// Debug status\nif (socChanged) {\n    node.status({ fill: \"green\", shape: \"dot\", text: `SOC: ${currentSoc}% (changed from ${previousSoc || 'N/A'}%)` });\n} else {\n    node.status({ fill: \"grey\", shape: \"ring\", text: `SOC: ${currentSoc}% (no change)` });\n}\n\n// Output routing:\n// Output 1: Debug (always)\n// Output 2: MQTT ThingsBoard (only if changed)\n// Output 3: RPC Response (only if RPC request)\n\nconst debugMsg = { ...msg };\nconst mqttMsg = socChanged ? { ...msg } : null;\nconst rpcMsg = isRpc ? { ...msg } : null;\n\nreturn [debugMsg, mqttMsg, rpcMsg];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1190,
        "y": 160,
        "wires": [
            [
                "bss_debug_json"
            ],
            [
                "bss_mqtt_telemetry"
            ],
            [
                "bss_rpc_response"
            ]
        ]
    },

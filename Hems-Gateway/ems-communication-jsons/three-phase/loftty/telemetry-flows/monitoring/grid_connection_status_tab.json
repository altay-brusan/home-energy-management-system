    {
        "id": "7bb863501a9945ef",
        "type": "function",
        "z": "5646d0725b2d5e9c",
        "name": "Check & Send if Grid OFF",
        "func": "const data = msg.payload;\n\nif (!data || data.length < 3) {\n    node.status({ fill: 'red', shape: 'ring', text: 'Read error' });\n    return null;\n}\n\n// Parse voltages (0.1V scale)\nconst phaseAVoltageV = data[0] * 0.1;\nconst phaseBVoltageV = data[1] * 0.1;\nconst phaseCVoltageV = data[2] * 0.1;\n\n// Grid connected if any phase > 150V\nconst gridConnected = (phaseAVoltageV > 150 || phaseBVoltageV > 150 || phaseCVoltageV > 150);\n\nconst state = {\n    kind: 'GridConnectionStatusState',\n    version: 1,\n    timestampUtc: new Date().toISOString(),\n    gatewayId: global.get('GATEWAY_ID') || 'EC100-GW-001',\n    phaseAVoltageV: phaseAVoltageV,\n    phaseBVoltageV: phaseBVoltageV,\n    phaseCVoltageV: phaseCVoltageV,\n    gridConnected: gridConnected\n};\n\n// Update flow context\nflow.set('gridConnectionStatus', state);\n\n// Only send to ThingsBoard if gridConnected = false\nif (!gridConnected) {\n    node.status({ fill: 'red', shape: 'dot', text: 'Grid OFF - Sending!' });\n    msg.payload = state;\n    msg.topic = 'v1/devices/me/telemetry';\n    return msg;\n} else {\n    node.status({ fill: 'green', shape: 'ring', text: 'Grid ON - Not sending' });\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 380,

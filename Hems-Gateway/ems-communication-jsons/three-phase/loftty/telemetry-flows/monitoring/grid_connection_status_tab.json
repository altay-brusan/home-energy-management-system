    {
        "id": "b7a1e3b5cb40ced4",
        "type": "modbus-flex-getter",
        "z": "675da65aaebc85c3",
        "name": "Read Grid Voltages (RPC)",
        "showStatusActivities": true,
        "showErrors": true,

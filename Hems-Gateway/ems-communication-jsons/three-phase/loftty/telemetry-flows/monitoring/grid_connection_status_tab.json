    {
        "id": "3b6390612fa35428",
        "type": "function",
        "z": "675da65aaebc85c3",
        "name": "Parse & Respond",
        "func": "const data = msg.payload;\n\nif (!data || data.length < 3) {\n    msg.payload = {\n        error: 'Failed to read grid voltages',\n        kind: 'GridConnectionStatusState'\n    };\n    node.status({ fill: 'red', shape: 'ring', text: 'Read error' });\n} else {\n    // Parse voltages (0.1V scale)\n    const phaseAVoltageV = data[0] * 0.1;\n    const phaseBVoltageV = data[1] * 0.1;\n    const phaseCVoltageV = data[2] * 0.1;\n\n    // Grid connected if any phase > 150V\n    const gridConnected = (phaseAVoltageV > 150 || phaseBVoltageV > 150 || phaseCVoltageV > 150);\n\n    msg.payload = {\n        kind: 'GridConnectionStatusState',\n        version: 1,\n        timestampUtc: new Date().toISOString(),\n        gatewayId: global.get('GATEWAY_ID') || 'EC100-GW-001',\n        phaseAVoltageV: phaseAVoltageV,\n        phaseBVoltageV: phaseBVoltageV,\n        phaseCVoltageV: phaseCVoltageV,\n        gridConnected: gridConnected\n    };\n\n    // Also update flow context\n    flow.set('gridConnectionStatus', msg.payload);\n\n    const statusText = gridConnected ? 'Grid ON' : 'Grid OFF';\n    node.status({ fill: 'green', shape: 'dot', text: `RPC: ${statusText}` });\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,

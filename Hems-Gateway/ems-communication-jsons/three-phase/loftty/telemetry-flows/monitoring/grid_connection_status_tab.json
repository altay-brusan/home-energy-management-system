    },
    {
        "id": "8564803a989a01e2",
        "type": "function",
        "z": "675da65aaebc85c3",
        "name": "Prep Read",
        "func": "msg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 698,\n    quantity: 3\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 180,
        "y": 100,
        "wires": [
            [
                "448bda36e0ba5937"
            ]
        ]
    },
    {
        "id": "1e6a8b2d4d29b646",
        "type": "function",
        "z": "675da65aaebc85c3",
        "name": "Parse & Store",
        "func": "const data = msg.payload;\n\nif (!data || data.length < 3) {\n    node.status({ fill: 'red', shape: 'ring', text: 'Invalid data' });\n    return null;\n}\n\n// Parse voltages (0.1V scale)\nconst phaseAVoltageV = data[0] * 0.1;\nconst phaseBVoltageV = data[1] * 0.1;\nconst phaseCVoltageV = data[2] * 0.1;\n\n// Grid connected if any phase > 150V\nconst gridConnected = (phaseAVoltageV > 150 || phaseBVoltageV > 150 || phaseCVoltageV > 150);\n\nconst state = {\n    kind: 'GridConnectionStatusState',\n    version: 1,\n    timestampUtc: new Date().toISOString(),\n    gatewayId: global.get('GATEWAY_ID') || 'EC100-GW-001',\n    phaseAVoltageV: phaseAVoltageV,\n    phaseBVoltageV: phaseBVoltageV,\n    phaseCVoltageV: phaseCVoltageV,\n    gridConnected: gridConnected\n};\n\n// Store to flow context\nflow.set('gridConnectionStatus', state);\n\nconst statusText = gridConnected ? 'Grid ON' : 'Grid OFF';\nconst statusColor = gridConnected ? 'green' : 'red';\nnode.status({ fill: statusColor, shape: 'dot', text: `${statusText} (A:${phaseAVoltageV.toFixed(1)}V)` });\n\nmsg.payload = state;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 100,
        "wires": [
            [
                "16da8e141aba6298"
            ]
        ]
    },

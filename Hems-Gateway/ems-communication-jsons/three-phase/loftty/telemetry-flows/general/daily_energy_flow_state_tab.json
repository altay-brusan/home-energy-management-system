    {
        "id": "def_build_json",
        "type": "function",
        "z": "daily_energy_flow_state_tab",
        "name": "Build DailyEnergyFlowState JSON",
        "func": "const base = msg.baseAddr;\nconst data = msg.payload.data || msg.payload;\n\n// Store partial results in flow context\nif (base === 614) {\n    // Battery: 614-615\n    flow.set(\"def_battery\", {\n        chargeEnergyKWh: data[0] * 0.1,      // 614\n        dischargeEnergyKWh: data[1] * 0.1    // 615\n    });\n}\nelse if (base === 620) {\n    // Grid: 620-621\n    flow.set(\"def_grid\", {\n        importEnergyKWh: data[0] * 0.1,      // 620\n        exportEnergyKWh: data[1] * 0.1       // 621\n    });\n}\nelse if (base === 626) {\n    // Load/PV/Gen: 626, 629, 636\n    flow.set(\"def_load\", data[0] * 0.1);                    // 626\n    flow.set(\"def_pv\", data[3] * 0.1);                      // 629 (offset 3)\n    flow.set(\"def_generator\", data[10] * 0.1);              // 636 (offset 10)\n}\n\n// Check if all parts are ready\nconst battery = flow.get(\"def_battery\");\nconst grid = flow.get(\"def_grid\");\nconst load = flow.get(\"def_load\");\nconst pv = flow.get(\"def_pv\");\nconst generator = flow.get(\"def_generator\");\n\nif (!battery || !grid || load === undefined || pv === undefined || generator === undefined) {\n    return null;  // Wait for all parts\n}\n\n// All data collected, build final JSON\nconst result = {\n    timestampUtc: new Date().toISOString(),\n    version: 1,\n    DeviceId: \"EC100\",\n    \n    loadEnergyKWh: load,\n    \n    grid: {\n        importEnergyKWh: grid.importEnergyKWh,\n        exportEnergyKWh: grid.exportEnergyKWh\n    },\n    \n    pv: {\n        totalEnergyKWh: pv,\n        mppt: [\n            { id: 1, energyKWh: null },  // Not available in datasheet\n            { id: 2, energyKWh: null },\n            { id: 3, energyKWh: null },\n            { id: 4, energyKWh: null }\n        ]\n    },\n    \n    battery: {\n        chargeEnergyKWh: battery.chargeEnergyKWh,\n        dischargeEnergyKWh: battery.dischargeEnergyKWh\n    },\n    \n    generator: {\n        energyKWh: generator\n    }\n};\n\n// Clear flow context\nflow.set(\"def_battery\", null);\nflow.set(\"def_grid\", null);\nflow.set(\"def_load\", null);\nflow.set(\"def_pv\", null);\nflow.set(\"def_generator\", null);\n\n// Check if this is an RPC request\nconst rpcTopic = flow.get(\"def_rpc_response_topic\");\nif (rpcTopic) {\n    // Send RPC response\n    msg.payload = { success: true, data: result };\n    msg.topic = rpcTopic;\n    flow.set(\"def_rpc_response_topic\", null);\n    return [msg, null];\n} else {\n    // Send telemetry\n    msg.payload = result;\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1010,
        "y": 160,
        "wires": [
            [
                "def_send_rpc_response"
            ],
            [
                "def_send_telemetry"
            ]
        ]
    },

    {
        "id": "def_prepare_batt",
        "type": "function",
        "z": "daily_energy_flow_state_tab",
        "name": "Prepare read (Battery 614-615)",
        "func": "// Store RPC response topic if present\nif (msg.rpcResponseTopic) {\n    flow.set(\"def_rpc_response_topic\", msg.rpcResponseTopic);\n}\n\n// Battery daily energy\n// 614: Today charge (0.1kWh)\n// 615: Today discharge (0.1kWh)\n\nmsg.baseAddr = 614;\nmsg.payload = {\n    fc: 3,\n    unitid: 1,\n    address: 614,\n    quantity: 2  // 614-615\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 100,
        "wires": [

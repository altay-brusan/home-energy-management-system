        "z": "07c807f73d1c2805",
        "name": "Handle RPC",
        "func": "const parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\n\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\n\nconst rpc = msg.payload || {};\n\nmsg.rpcMethod = rpc.method;\nmsg.rpcParams = rpc.params || {};\n\nif (msg.rpcMethod === 'getInverterInfo') {\n    msg.isRpcRequest = true;\n    return msg;\n}\nelse {\n    return null;\n}",

        "func": "const parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\n\nconst rpc = msg.payload || {};\nconst method = rpc.method;\n\nif (method !== 'getDailyEnergyFlowState') {\n    return null;\n}\n\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\nmsg.rpcMethod = method;\nmsg.rpcParams = rpc.params || {};\n\nreturn msg;",

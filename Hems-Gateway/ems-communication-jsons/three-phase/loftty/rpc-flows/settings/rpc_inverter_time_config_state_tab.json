    {
        "id": "rpc_itc_handle",
        "type": "function",
        "z": "37bdf0658dcbdf1c",
        "name": "Handle RPC",
        "func": "const parts = msg.topic.split('/');\nconst requestId = parts[parts.length - 1];\n\nmsg.rpcRequestId = requestId;\nmsg.rpcResponseTopic = 'v1/devices/me/rpc/response/' + requestId;\n\nconst rpc = msg.payload || {};\n\nmsg.rpcMethod = rpc.method;\nmsg.rpcParams = rpc.params || {};\n\n// Handle both get and set methods\nif (msg.rpcMethod === 'getInverterTimeConfigState') {\n    msg.operationType = 'read';\n    return msg;\n} else if (msg.rpcMethod === 'setInverterTimeConfigState') {\n    msg.operationType = 'write';\n    return msg;\n}\n\nreturn null;",

ExternalRelayConfigState
{
  "version": 1,

  "externalRelayFeatureEnabled": "boolean",  // 278 Bit8-9 - external relay feature
                                             //   10 = disable
                                             //   11 = enable

  "relayBitmapRaw": "number",                // 294 - 外部继电器位 External relay bit
                                             //   [0, 0xFFFF]
                                             //   Bit0-8 corresponds to 8 relay positions

  "relays": [
    {
      "relayId": "number",                   // 0..7, matches bit index in 294
      "logicalRole": "string",               // "generator_start" | "alarm" | "dry_contact" | "spare"
      "normallyOpen": "boolean",             // Wiring choice
      "description": "string"                // Free text, e.g. "GV – diesel start contactor"
    }
  ]
}
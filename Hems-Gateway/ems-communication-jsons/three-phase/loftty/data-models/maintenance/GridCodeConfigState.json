                                             //   1 = UL1741 & IEEE1547
                                             //   2 = CPUC RULE21
                                             //   3 = SRD-UL1741
                                             //   4 = CEI 0-21

  "gridFrequencyHz": "number",               // 283 - 电网频率设置 Grid Frequency
                                             //   0x00 = 50Hz
                                             //   0x01 = 60Hz

  "outputVoltageLevelCode": "number",        // 238 - 输出电压等级设定 Output voltage level
                                             //   0 = 220V
                                             //   1 = 230V
                                             //   2 = 240V
                                             //   3 = 120V
                                             //   4 = 133VAC

  "normalConnect": {
    "voltageHighV": "number",                // 285 - 电网高压保护点 Grid Vol High (0.1V) [1800,2700]
    "voltageLowV": "number",                 // 286 - 电网低压保护点 Grid Vol Low (0.1V) [1800,2700]
    "frequencyHighHz": "number",             // 287 - 电网频率高保护点 Grid Hz High (0.01Hz) [4500,6500]
    "frequencyLowHz": "number"               // 288 - 电网频率低保护点 Grid Hz Low (0.01Hz) [4500,6500]
  },

  "reconnectionTimeSeconds": "number",       // 280 - 恢复并网时间 Restore connection time [10,300]

  "powerFactorTarget": "number",             // 293 - 输出PF值设定 Output PF value (800=80%, 1000=100%, 1200=120%)

  "activePowerRegulationPercentPerStep": "number",    // bu hatalı geldi ffff geldi bun batarya ile test edecez 177 - 有功功率调节 Active power regulation [0,1200] (0.1%)
  
  "reactivePowerRegulationPercentPerStep": "number"   // 178 - 无功功率调节 Reactive power regulation [0,1200] (0.1%)

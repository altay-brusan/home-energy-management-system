{
  "timestampUtc": "string",
  "version": 1,
  "DeviceId": "string",

  "runState": "string",                      // 600 - "standby"|"selfcheck"|"normal"|"alarm"|"fault"

  "output": {
    "totalActivePowerW": "number",           // 736 (low) + 794 (high) - Total active power (1W, S32)
    "totalApparentPowerVA": "number",        // 737 (low) + 795 (high) - Total apparent power (1W, S32)
    "frequencyHz": "number",                 // 738 - Inverter frequency (0.01Hz)
    
    "phaseA": {
      "voltageV": "number",                  // 727 - Phase A voltage (0.1V)
      "currentA": "number",                  // 730 - Phase A current (0.01A, S16)
      "activePowerW": "number"               // 733 (low) + 791 (high) - Phase A power (1W, S32)
    },
    "phaseB": {
      "voltageV": "number",                  // 728 - Phase B voltage (0.1V)
      "currentA": "number",                  // 731 - Phase B current (0.01A, S16)
      "activePowerW": "number"               // 734 (low) + 792 (high) - Phase B power (1W, S32)
    },
    "phaseC": {
      "voltageV": "number",                  // 729 - Phase C voltage (0.1V)
      "currentA": "number",                  // 732 - Phase C current (0.01A, S16)
      "activePowerW": "number"               // 735 (low) + 793 (high) - Phase C power (1W, S32)
    }
  },

  "gridSide": {
    "totalActivePowerW": "number",           // 725 (low) + 790 (high) - Grid total power (1W, S32)
    "phaseAPowerW": "number",                // 722 (low) + 787 (high) - Grid A-phase power (1W, S32)
    "phaseBPowerW": "number",                // 723 (low) + 788 (high) - Grid B-phase power (1W, S32)
    "phaseCPowerW": "number"                 // 724 (low) + 789 (high) - Grid C-phase power (1W, S32)
  },

  "temperatures": {
    "dcTransformerTempC": "number",          // 640 - DC transformer temp (0.1°C, offset 1000)
    "heatsinkTempC": "number"                // 641 - Heat sink temp (0.1°C)
  },

  "acInputStatus": {
    "genGridSignalRaw": "number",            // 240 - Gen_Grid_Signal (R/W register)
    "gridSignalPresent": "boolean",          // 240 bit0 == 1 → grid OK
    "generatorSignalPresent": "boolean"      // 240 bit1 == 1 → generator OK
  }
}
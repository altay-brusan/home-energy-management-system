GeneratorAndSmartLoadConfigState {
  "timestampUtc": string,
  "gatewayId": string,
  "inverterSerialNumber": string,
  "version": string,

  // ─────────────────────────────────────────
  // A. Global battery-charge sources
  // (Battery Setting → Grid Charge / Gen Charge)
  // ─────────────────────────────────────────

  // “Gen Charge” checkbox – allow generator to charge battery
  "generatorChargeEnabled": bool,        // 129  (1 = enabled)

  // “Grid Charge” checkbox – allow grid to charge battery
  "gridChargeEnabled": bool,             // 130  (1 = enabled)


  // ─────────────────────────────────────────
  // B. Generator auto-start / auto-charge from SOC
  // ─────────────────────────────────────────

  // Convenience flag: in your backend you can compute this as
  // (generatorChargeEnabled == true && startSocPercent > 0)
  "autoStartEnabled": bool,

  // How long the generator is allowed to run in one session
  "maxRunTimeHours": number,             // 121  (0.1 h units in Modbus)

  // How long it must rest before next run
  "coolingTimeHours": number,            // 122  (0.1 h units in Modbus)

  // Start condition based on battery SOC:
  // "Start generator when battery SOC drops below this threshold"
  "startSocPercent": number,             // 124  (1% steps)

  // How hard the generator charges the battery
  "chargeCurrentA": number,              // 125  (A)


  // ─────────────────────────────────────────
  // C. Generator peak-shaving behaviour
  // (this is what we called “auto-shaving”)
  // ─────────────────────────────────────────

  "generatorPeakShaving": {
    // Reg 178 Bit2–3:
    //   10 = Gen peak-shaving disable
    //   11 = Gen peak-shaving enable
    "enabled": bool,                     // 178 Bits2–3

    // Limit for generator power used in peak-shaving mode.
    // HMI label: “GEN peak shaving Power” / “Gen input rated power”
    "limitPowerW": number                // 190  (LV: 1 W units, HV: 10 W units)
  },


  // ─────────────────────────────────────────
  // D. Smart-Load behaviour on GEN port
  // ─────────────────────────────────────────

  "smartLoad": {
    // Is GEN port actually used as Smart Load output?
    // (derive: reg133 == 1 AND 178 Bit8–9 == “external relay enable” AND 235 == 1 on some firmwares)
    "enabled": bool,

    // Battery SOC at which Smart Load turns OFF
    "offSocPercent": number,            // 135  SmartLoad OFF batt (1%)

    // Battery SOC at which Smart Load turns ON
    "onSocPercent": number,             // 137  SmartLoad ON batt (1%)

    // PV power threshold – PV power must exceed this value
    // together with onSocPercent for Smart Load to turn on
    "pvPowerThresholdW": number,        // 139  minimum solar power required

    // Delay from conditions met → Smart Load actually switched ON
    "openDelayMinutes": number,         // 192  Smart Load Open Delay (minutes)

    // Behaviour when grid goes away:
    // false  = default: "off grid immediately off"
    // true   = HMI option "On Grid always on"
    "onGridAlwaysOn": bool              // 178 Bits6–7 (11 = enable, 10 = disable)
  }
}

SystemWorkModeConfigState
{
  "version": 1,

  "userModeProfile": "string",               // "self_consumption" | "backup" | "time_of_use" | "eco" | "custom" - derived

  "inverterMode": {
    "workModeCode": "number",                // 241 - Energy management model
                                             //   Bit0-1: 10 = battery first mode
                                             //           11 = load first mode
                                             //   Bit2-3: Passive grid balance (被动并网功率平衡)
                                             //           10 = close (disable)
                                             //           11 = open (enable)
                                             //   Bit4-5: Active grid balance (主动并网功率平衡)
                                             //           10 = close (disable)
                                             //           11 = open (enable)
    
    "exportStrategy": "string",              // 242 - limit控制功能
                                             //   0x00 = sell electricity enabled (使能卖电)
                                             //   0x01 = built-in CT enabled (使能内置)
                                             //   0x02 = external CT enabled (使能外置)

    "solarSellEnabled": "boolean",           // 245 - Solar sell (光伏卖电)
                                             //   0x00 = solar don't sell
                                             //   0x01 = solar sell

    "maxSellPowerW": "number",               // 243 - Limit max grid power output (1W)

    "defaultMaxSellPowerW": null,            // Bu datasheet'te yok (244 = CT direction)

    "zeroExportLimitPowerW": null,           // Bu datasheet'te zero export power register yok

    "forceOffGrid": "boolean"                // 279 Bit2-3 - 强制离网工作 Forced off-grid
                                             //   10 = disable
                                             //   11 = enable
  },

  "energyPriority": {
    "pattern": "string"                      // 241 Bit0-1 (yukarıdaki ile aynı register)
                                             //   10 (binary) = battery_first
                                             //   11 (binary) = load_first
  },

  "gridPeakShaving": {
    "enabled": "boolean",                    // 278 Bit4-5 - Grid peak-shaving
                                             //   10 = disable
                                             //   11 = enable
    "limitPowerW": "number"                  // 291 - GRID peak shaving Power (1W)
  },

  "timeOfUse": {
    "enabled": "boolean",                    // 246 Bit0 - 高级削峰填谷功能使能
                                             //   0 = disable
                                             //   1 = enable

    "daysActive": {                          // 246 Bit1-7 - Weekday flags
      "monday": "boolean",                   //   Bit1: 0=disable, 1=enable
      "tuesday": "boolean",                  //   Bit2: 0=disable, 1=enable
      "wednesday": "boolean",                //   Bit3: 0=disable, 1=enable
      "thursday": "boolean",                 //   Bit4: 0=disable, 1=enable
      "friday": "boolean",                   //   Bit5: 0=disable, 1=enable
      "saturday": "boolean",                 //   Bit6: 0=disable, 1=enable
      "sunday": "boolean"                    //   Bit7: 0=disable, 1=enable
    },

    "slots": [
      {

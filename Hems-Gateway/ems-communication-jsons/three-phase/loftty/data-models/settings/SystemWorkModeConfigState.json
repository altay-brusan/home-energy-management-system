        "startTimeLocal": "string",          // 248 - Time point 1 (HHMM format, 2359 = 23:59)
        "endTimeLocal": "string",            // 249 - Time point 2
        "allowGridCharge": "boolean",        // 272 Bit0 - grid charging enable (0=disable, 1=enable)
        "allowGeneratorCharge": "boolean",   // 272 Bit1 - gen charging enable (0=disable, 1=enable)
                                             // 272 Bit2 - Spain GM mode (bölgesel, ignore)
                                             // 272 Bit3 - Spain BU mode (bölgesel, ignore)
        "sellEnabledInThisSlot": null,       // Bu datasheet'te Bit5 tanımlı değil
        "maxBatteryDischargePowerW": "number", // 254 - Time point 1 power (1W)
        "batteryThresholdSocPercent": "number", // 266 - Capacity 1 (1%)

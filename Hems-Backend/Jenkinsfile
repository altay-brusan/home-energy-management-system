pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
  - name: docker
    image: docker:27.0-cli
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: kubectl
    image: alpine/k8s:1.28.3
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
            """
        }
    }

    environment {
        // Docker Registry Configuration
        DOCKER_REGISTRY = 'registry.oklidis.com.tr:5000'
        DOCKER_IMAGE_NAME = 'hems-backend'

        // Build Info
        GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        BUILD_TAG = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}-${GIT_COMMIT_SHORT}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "🔄 Checking out code from ${env.BRANCH_NAME} branch..."
                checkout scm
            }
        }

        stage('Build Docker Image - Development') {
            when {
                branch 'dev'
            }
            steps {
                echo "🐳 Building Docker image for DEVELOPMENT environment..."
                container('docker') {
                    sh """
                        docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG} -f src/Web/Dockerfile .
                        docker tag ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG} ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-latest
                    """
                }
            }
        }

        stage('Build Docker Image - Stage') {
            when {
                branch 'stage'
            }
            steps {
                echo "🐳 Building Docker image for STAGE environment..."
                container('docker') {
                    sh """
                        docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stage-${BUILD_TAG} -f src/Web/Dockerfile .
                        docker tag ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stage-${BUILD_TAG} ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stage-latest
                    """
                }
            }
        }

        stage('Push Docker Image - Development') {
            when {
                branch 'dev'
            }
            steps {
                echo "📦 Pushing Docker image to registry (DEVELOPMENT)..."
                container('docker') {
                    sh """
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-latest
                    """
                }
            }
        }

        stage('Push Docker Image - Stage') {
            when {
                branch 'stage'
            }
            steps {
                echo "📦 Pushing Docker image to registry (STAGE)..."
                container('docker') {
                    sh """
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stage-${BUILD_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stage-latest
                    """
                }
            }
        }

        stage('Deploy to K3s - Development') {
            when {
                branch 'dev'
            }
            steps {
                echo "🚀 Deploying to K3s DEVELOPMENT namespace..."
                container('kubectl') {
                    sh """
                        kubectl set image deployment/hems-backend-dev \
                            hems-backend=${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG} \
                            -n hems-dev

                        kubectl rollout status deployment/hems-backend-dev \
                            -n hems-dev \
                            --timeout=5m
                    """
                }
            }
            post {
                success {
                    echo "✅ Successfully deployed to DEVELOPMENT environment!"
                    echo "🌐 URL: http://hems-api-dev.oklidis.com.tr"
                }
                failure {
                    echo "❌ Deployment to DEVELOPMENT failed!"
                }
            }
        }

        stage('Deploy to K3s - Stage') {
            when {
                branch 'stage'
            }
            steps {
                echo "🚀 Deploying to K3s STAGE namespace..."
                container('kubectl') {
                    sh """
                        kubectl set image deployment/hems-backend-stage \
                            hems-backend=${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stage-${BUILD_TAG} \
                            -n hems-stage

                        kubectl rollout status deployment/hems-backend-stage \
                            -n hems-stage \
                            --timeout=5m
                    """
                }
            }
            post {
                success {
                    echo "✅ Successfully deployed to STAGE environment!"
                    echo "🌐 URL: http://hems-api-stage.oklidis.com.tr"
                }
                failure {
                    echo "❌ Deployment to STAGE failed!"
                }
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning up workspace..."
            deleteDir()
        }
        success {
            echo "✅ Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed!"
        }
    }
}
